{% liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 8
%}

<div class="hp-wrap">
  <section class="hp-section">
    <header class="hp-section__head">
      <div>
        <h1 class="hp-h2">{{ section.settings.heading | escape }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="hp-subhead">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="hp-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
      {% endif %}
    </header>

    {% if collection != blank and collection.products_count > 0 %}
      <div class="hp-grid hp-products">
        {% for product in collection.products limit: product_limit %}
          <article class="hp-card hp-product">
            <a class="hp-product__img" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 640 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% endif %}
            </a>

            {% if product.vendor != blank %}
              <div class="hp-pill">{{ product.vendor | escape }}</div>
            {% endif %}

            <h2 class="hp-product__title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h2>

            <div class="hp-price">
              <b>{{ product.price | money }}</b>
              {% if product.compare_at_price_max > product.price %}
                <span><s>{{ product.compare_at_price_max | money }}</s></span>
              {% endif %}
            </div>

            <a class="hp-btn" href="{{ product.url }}">{{ section.settings.card_cta_label | escape }}</a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="hp-card hp-page__card">
        <p class="hp-subhead" style="margin:0;">
          Pick a collection in this section's settings (or add products to that collection in Shopify Admin).
        </p>
      </div>
    {% endif %}
  </section>
</div>

{% schema %}
{
  "name": "Featured collection grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse premium problem-solving essentials — curated for quick wins."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card button label",
      "default": "View"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Top-right link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Top-right link"
    }
  ],
  "presets": [
    {
      "name": "Featured collection grid"
    }
  ]
}
{% endschema %}

