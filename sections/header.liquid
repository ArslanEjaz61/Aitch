<!-- Announcement Bar -->
<div class="announcement-bar">
  <div class="announcement-bar__inner">
    <div class="announcement-bar__item">
      <svg class="announcement-bar__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <span>{{ section.settings.announcement_1 | default: 'FREE SHIPPING ON ORDERS OVER $50' | escape }}</span>
    </div>
    <div class="announcement-bar__divider"></div>
    <div class="announcement-bar__item">
      <svg class="announcement-bar__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
      <span>{{ section.settings.announcement_2 | default: '30-DAY HASSLE-FREE RETURNS' | escape }}</span>
    </div>
    <div class="announcement-bar__divider"></div>
    <div class="announcement-bar__item">
      <svg class="announcement-bar__icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
      <span>{{ section.settings.announcement_3 | default: 'SHIPS TO USA & CANADA' | escape }}</span>
    </div>
  </div>
</div>

<!-- Header -->
<header class="header" role="banner">
  <div class="header__inner">
    <!-- Logo (column 1) -->
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if settings.logo != blank %}
        <img
          class="header__logo-img"
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          loading="eager"
          width="120"
          style="max-width: 120px; width: 100%; height: auto;"
        >
      {% else %}
        <img
          class="header__logo-img"
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          loading="eager"
          width="120"
          style="max-width: 120px; width: 100%; height: auto;"
        >
      {% endif %}
    </a>

    <!-- Desktop nav — centered (column 2) -->
    <nav class="header__nav" aria-label="Main navigation">
      {% assign main_menu = linklists[section.settings.menu] %}
      {% for link in main_menu.links %}
        {% if link.links.size > 0 %}
          <div class="header__dropdown">
            <a href="{% render 'nav-resolved-url', nav_link: link %}" class="header__dropdown-trigger">
              {{ link.title | escape }}
              <svg class="header__dropdown-arrow" viewBox="0 0 24 24" width="12" height="12"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="header__dropdown-menu">
              {% for child_link in link.links %}
                <a href="{% render 'nav-resolved-url', nav_link: child_link %}">{{ child_link.title | escape }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{% render 'nav-resolved-url', nav_link: link %}">{{ link.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- Utilities (column 3) -->
    <div class="header__actions">
      <a class="header__action-btn" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </a>
      <a class="header__action-btn" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a class="header__action-btn" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <!-- Mobile menu toggle -->
      <button class="header__menu-toggle" aria-label="Open menu">
        <svg viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu — also uses Shopify Menu -->
<div class="mobile-menu">
  <div class="mobile-menu__header">
    <a class="header__logo" href="{{ routes.root_url }}">
      {% if settings.logo != blank %}
        <img class="header__logo-img" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="lazy" width="100" style="max-width: 100px; width: 100%; height: auto;">
      {% else %}
        <img class="header__logo-img" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" width="100" style="max-width: 100px; width: 100%; height: auto;">
      {% endif %}
    </a>
    <button class="mobile-menu__close" aria-label="Close menu">
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <nav class="mobile-menu__nav">
    {% for link in main_menu.links %}
      <a href="{% render 'nav-resolved-url', nav_link: link %}">{{ link.title | escape }}</a>
      {% if link.links.size > 0 %}
        {% for child_link in link.links %}
          <a href="{% render 'nav-resolved-url', nav_link: child_link %}" class="mobile-menu__sublink">{{ child_link.title | escape }}</a>
        {% endfor %}
      {% endif %}
    {% endfor %}
    <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    <a href="{{ routes.account_url }}">Account</a>
  </nav>
</div>

<!-- Search Modal Drawer Overlay -->
<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog">
  <div class="search-modal__overlay" onclick="closeSearchModal()"></div>
  <div class="search-modal__content">
    <div class="search-modal__header">
      <h2 class="search-modal__title">Search our store</h2>
      <button type="button" class="search-modal__close" onclick="closeSearchModal()" aria-label="Close search">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <form action="{{ routes.search_url }}" method="get" class="search-modal__form">
      <input 
        type="text" 
        name="q" 
        id="search-modal-input" 
        placeholder="What are you looking for?" 
        autocomplete="off"
        class="search-modal__input"
      >
      <button type="submit" class="search-modal__submit" aria-label="Submit search">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </button>
    </form>

    {%- capture suggested_links_html -%}
      {%- liquid
        assign suggested_handles = 'cleaning,kitchen-tools,kitchen,home-convenience,home-convenience-items,best-sellers,best-sales' | split: ','
      -%}
      <a href="/collections/all">Shop All</a>
      {%- for handle in suggested_handles -%}
        {%- assign coll = collections[handle] -%}
        {%- if coll != blank and coll.title != blank -%}
          <a href="{{ coll.url }}">{{ coll.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if pages['best-sellers'] != blank -%}
        <a href="/pages/best-sellers">Best Sellers</a>
      {%- endif -%}
    {%- endcapture -%}

    <div class="search-modal__results" id="search-modal-results">
      <!-- Default suggestions when input is empty -->
      <div class="search-modal__suggestions">
        <h3 class="search-modal__subtitle">Popular Suggestions</h3>
        <div class="search-modal__suggested-links">
          {{ suggested_links_html }}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Search Modal Logic Script -->
<script>
  function openSearchModal(e) {
    if (e) e.preventDefault();
    var modal = document.getElementById('search-modal');
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(function() {
        var input = document.getElementById('search-modal-input');
        if (input) input.focus();
      }, 100);
    }
  }

  function closeSearchModal() {
    var modal = document.getElementById('search-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  // Bind all search trigger buttons
  document.addEventListener('DOMContentLoaded', function() {
    var searchBtns = document.querySelectorAll('a[href*="/search"], button[aria-label="Search"]');
    searchBtns.forEach(function(btn) {
      btn.addEventListener('click', openSearchModal);
    });

    // Predictive live suggestions
    var searchInput = document.getElementById('search-modal-input');
    var searchResults = document.getElementById('search-modal-results');
    
    if (searchInput && searchResults) {
      var debounceTimer;
      searchInput.addEventListener('input', function() {
        var query = searchInput.value.trim();
        clearTimeout(debounceTimer);
        
        if (query.length < 2) {
          searchResults.innerHTML = `
            <div class="search-modal__suggestions">
              <h3 class="search-modal__subtitle">Popular Suggestions</h3>
              <div class="search-modal__suggested-links">
                {{ suggested_links_html | strip | strip_newlines }}
              </div>
            </div>
          `;
          return;
        }

        debounceTimer = setTimeout(function() {
          searchResults.innerHTML = '<div style="text-align:center;padding:var(--space-md);color:var(--color-text-secondary);font-size:var(--font-size-sm);">Searching suggestions...</div>';
          
          fetch('{{ routes.search_url }}/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=5')
            .then(function(res) { return res.json(); })
            .then(function(data) {
              var products = data.resources.results.products;
              if (products && products.length > 0) {
                var html = '<h3 class="search-modal__subtitle">Suggested Products</h3>';
                products.forEach(function(p) {
                  html += `
                    <a href="${p.url}" class="search-modal__item">
                      <img src="${p.image || 'https://cdn.shopify.com/s/images/admin/no-image-large.gif'}" class="search-modal__item-img" alt="${p.title}">
                      <div class="search-modal__item-info">
                        <span class="search-modal__item-title">${p.title}</span>
                        <span class="search-modal__item-price">${p.price}</span>
                      </div>
                    </a>
                  `;
                });
                searchResults.innerHTML = html;
              } else {
                searchResults.innerHTML = `
                  <div class="search-modal__suggestions" style="text-align: center; padding: var(--space-lg) 0;">
                    <h3 class="search-modal__subtitle" style="margin-bottom: var(--space-xs);">Not found</h3>
                    <p style="font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-bottom: var(--space-md);">We couldn't find any matching products.</p>
                    <a href="/collections/all" class="btn btn--primary btn--sm" style="display: inline-block; text-decoration: none; padding: 8px 16px; font-size: var(--font-size-xs); line-height: 1;">Go to Shop</a>
                  </div>
                `;
              }
            })
            .catch(function(err) {
              console.error('Predictive search suggestions error:', err);
            });
        }, 250);
      });
    }
  });
</script>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Aitch Home Care"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Links come from Admin → Navigation. The theme auto-fixes: “Shop” → all products; “Best Sellers” / “Best Sallers” if wrongly set to Contact → page handle best-sellers; “Home convenience” → collection home-convenience-items when it exists."
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "text",
      "id": "announcement_1",
      "label": "Announcement 1",
      "default": "FREE SHIPPING ON ORDERS OVER $50"
    },
    {
      "type": "text",
      "id": "announcement_2",
      "label": "Announcement 2",
      "default": "30-DAY HASSLE-FREE RETURNS"
    },
    {
      "type": "text",
      "id": "announcement_3",
      "label": "Announcement 3",
      "default": "SHIPS TO USA & CANADA"
    }
  ]
}
{% endschema %}
