{% liquid
  assign products = collection.products
  assign product_limit = section.settings.products_per_page | default: 16
%}

<div class="hp-page">
  <header class="hp-section__head" style="margin-bottom: 16px;">
    <div>
      <h1 class="hp-h2">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <p class="hp-subhead">{{ collection.description | strip_html | escape }}</p>
      {% endif %}
    </div>
  </header>

  {% if collection.products_count == 0 %}
    <div class="hp-card hp-page__card">
      <p class="hp-subhead" style="margin:0;">No products found in this collection yet.</p>
    </div>
  {% else %}
    <div class="hp-grid hp-products">
      {% for product in products limit: product_limit %}
        <article class="hp-card hp-product">
          <a class="hp-product__img" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                srcset="
                  {{ product.featured_image | image_url: width: 320 }} 320w,
                  {{ product.featured_image | image_url: width: 480 }} 480w,
                  {{ product.featured_image | image_url: width: 640 }} 640w
                "
                sizes="(max-width: 520px) 92vw, (max-width: 1020px) 44vw, 22vw"
                src="{{ product.featured_image | image_url: width: 640 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {% endif %}
          </a>

          <h2 class="hp-product__title" style="margin-top:2px;">
            <a href="{{ product.url }}">{{ product.title | escape }}</a>
          </h2>

          <div class="hp-price">
            <b>{{ product.price | money }}</b>
            {% if product.compare_at_price_max > product.price %}
              <span><s>{{ product.compare_at_price_max | money }}</s></span>
            {% endif %}
          </div>

          <a class="hp-btn" href="{{ product.url }}">View</a>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products to show",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}

