{% liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 12
%}

<div class="container section-spacing">
  <div class="section-header">
    <div class="section-header__text">
      <div class="section-header__eyebrow">{{ section.settings.eyebrow | default: 'Collection' | escape }}</div>
      <h1 class="section-header__title">{{ section.settings.heading | default: 'Shop' | escape }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>
    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <a class="btn btn--secondary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
    {% endif %}
  </div>

  {% if collection != blank and collection.products_count > 0 %}
    <div class="product-grid product-grid--4">
      {% for product in collection.products limit: product_limit %}
        <article class="product-card">
          {% if product.compare_at_price_max > product.price %}
            <span class="product-card__badge product-card__badge--sale">Sale</span>
          {% endif %}

          <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                srcset="
                  {{ product.featured_image | image_url: width: 400 }} 400w,
                  {{ product.featured_image | image_url: width: 600 }} 600w,
                  {{ product.featured_image | image_url: width: 800 }} 800w
                "
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {% endif %}

            {% if product.images.size > 1 %}
              <div class="product-card__media-hover">
                <img
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="product-card__quick-add">
              <span class="btn btn--primary btn--full">Quick View</span>
            </div>
          </a>

          <div class="product-card__info">
            {% if product.vendor != blank %}
              <div class="product-card__vendor">{{ product.vendor | escape }}</div>
            {% endif %}

            <h2 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h2>

            <div class="product-card__price">
              {% if product.compare_at_price_max > product.price %}
                <span class="product-card__price-sale">{{ product.price | money }}</span>
                <span class="product-card__price-compare">{{ product.compare_at_price_max | money }}</span>
              {% else %}
                <span class="product-card__price-current">{{ product.price | money }}</span>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-state">
      <div class="empty-state__icon">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </div>
      <h3 class="empty-state__title">No products yet</h3>
      <p class="empty-state__text">Pick a collection in this section's settings to display products.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured collection grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse premium problem-solving essentials — curated for quick wins."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Top-right link label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Top-right link"
    }
  ],
  "presets": [
    {
      "name": "Featured collection grid"
    }
  ]
}
{% endschema %}
