<div class="container section-spacing">
  <div class="section-header">
    <div class="section-header__text">
      <div class="section-header__eyebrow">Browse</div>
      <h1 class="section-header__title">{{ section.settings.heading | default: 'Shop by Category' | escape }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>
  </div>

  <div class="categories-grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'category' %}
          <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                srcset="
                  {{ block.settings.image | image_url: width: 640 }} 640w,
                  {{ block.settings.image | image_url: width: 960 }} 960w,
                  {{ block.settings.image | image_url: width: 1280 }} 1280w
                "
                sizes="(max-width: 900px) 100vw, 33vw"
                src="{{ block.settings.image | image_url: width: 960 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% else %}
              {% liquid
                assign fallback_img = 'category-cleaning.jpg'
                if block.settings.title contains 'Kitchen'
                  assign fallback_img = 'category-kitchen.jpg'
                elsif block.settings.title contains 'Home'
                  assign fallback_img = 'category-home.jpg'
                endif
              %}
              <img
                src="{{ fallback_img | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="960"
                height="auto"
                style="object-fit: cover; width: 100%; height: 100%;"
              >
            {% endif %}
            <div class="category-card__overlay"></div>
            <div class="category-card__content">
              <h2 class="category-card__title">{{ block.settings.title | escape }}</h2>
              <div class="category-card__count">{{ block.settings.body | default: 'Shop now →' | escape }}</div>
            </div>
          </a>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Categories grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find the right solution for every area in your home."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cleaning Tools" },
        { "type": "textarea", "id": "body", "label": "Subtitle / Count", "default": "8 products" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Categories grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Cleaning Tools", "body": "8 products" } },
        { "type": "category", "settings": { "title": "Kitchen Essentials", "body": "6 products" } },
        { "type": "category", "settings": { "title": "Home Convenience", "body": "6 products" } }
      ]
    }
  ]
}
{% endschema %}
