<div class="hp-wrap">
  <section class="hp-section">
    <header class="hp-section__head">
      <div>
        <h1 class="hp-h2">{{ section.settings.heading | escape }}</h1>
        {% if section.settings.subheading != blank %}
          <p class="hp-subhead">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    </header>

    <div class="hp-grid hp-cats">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category' %}
            <article class="hp-card hp-cat" {{ block.shopify_attributes }}>
              <a class="hp-cat__img" href="{{ block.settings.link }}">
                {% if block.settings.image != blank %}
                  <img
                    srcset="
                      {{ block.settings.image | image_url: width: 640 }} 640w,
                      {{ block.settings.image | image_url: width: 960 }} 960w,
                      {{ block.settings.image | image_url: width: 1280 }} 1280w
                    "
                    sizes="(max-width: 900px) 92vw, 30vw"
                    src="{{ block.settings.image | image_url: width: 960 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                {% endif %}
              </a>

              <h2 class="hp-cat__title">
                <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
              </h2>
              <p class="hp-cat__body">{{ block.settings.body | escape }}</p>
              <a class="hp-btn" href="{{ block.settings.link }}">{{ section.settings.card_cta_label | escape }}</a>
            </article>
        {% endcase %}
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Categories grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Categories"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick a problem area — we’ll show the cleanest solutions."
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card button label",
      "default": "Explore"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Leak fixes" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Seal, tighten, repair — fast." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Categories grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Leak fixes", "body": "Seal, tighten, repair — fast." } },
        { "type": "category", "settings": { "title": "Organization", "body": "Clean storage for high-traffic spaces." } },
        { "type": "category", "settings": { "title": "Upgrades", "body": "Small changes, big feel." } }
      ]
    }
  ]
}
{% endschema %}

