<div class="search-page">
  <div class="section-header" style="border-bottom:none;margin-bottom:0;">
    <div class="section-header__text">
      <div class="section-header__eyebrow">Search</div>
      <h1 class="section-header__title">
        {% if search.performed %}
          Results for "{{ search.terms | escape }}"
        {% else %}
          Search
        {% endif %}
      </h1>
    </div>
  </div>

  <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
    <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search for products..." autocomplete="off">
    <button class="btn btn--primary" type="submit">Search</button>
  </form>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <div class="empty-state">
        <div class="empty-state__icon">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </div>
        <h3 class="empty-state__title">No results found</h3>
        <p class="empty-state__text">Try a different search term or browse our collections.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Browse All Products</a>
      </div>
    {% else %}
      <div class="product-grid product-grid--4">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <article class="product-card">
              {% if item.compare_at_price_max > item.price %}
                <span class="product-card__badge product-card__badge--sale">Sale</span>
              {% endif %}

              <a class="product-card__media" href="{{ item.url }}">
                {% if item.featured_image %}
                  <img
                    src="{{ item.featured_image | image_url: width: 600 }}"
                    alt="{{ item.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ item.featured_image.width }}"
                    height="{{ item.featured_image.height }}"
                  >
                {% endif %}
              </a>

              <div class="product-card__info">
                <h2 class="product-card__title">
                  <a href="{{ item.url }}">{{ item.title | escape }}</a>
                </h2>
                <div class="product-card__price">
                  {% if item.compare_at_price_max > item.price %}
                    <span class="product-card__price-sale">{{ item.price | money }}</span>
                    <span class="product-card__price-compare">{{ item.compare_at_price_max | money }}</span>
                  {% else %}
                    <span class="product-card__price-current">{{ item.price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </article>
          {% else %}
            <article class="product-card" style="padding:var(--space-lg);">
              <h2 class="product-card__title">
                <a href="{{ item.url }}">{{ item.title | escape }}</a>
              </h2>
              <p style="font-size:var(--font-size-sm);color:var(--color-text-secondary);margin-top:var(--space-xs);">{{ item.content | strip_html | truncate: 120 }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
