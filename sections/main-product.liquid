{% liquid
  assign featured = product.featured_image
  assign related_collection = product.collections.first
  assign current_variant = product.selected_or_first_available_variant
%}

<div class="product-page">
  <!-- ==========================================
       GALLERY — Thumbnails left, Main image right
       ========================================== -->
  <div class="product-page__gallery">
    <!-- Thumbnail Strip (Vertical on desktop, Horizontal on mobile) -->
    {% if product.images.size > 1 %}
      <div class="product-page__thumbs-strip">
        {% for image in product.images %}
          <button
            class="product-page__thumb {% if forloop.first %}active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="View image {{ forloop.index }}"
            onclick="
              document.getElementById('product-main-img').src='{{ image | image_url: width: 1200 }}';
              document.getElementById('product-main-img').srcset='{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w';
              document.querySelectorAll('.product-page__thumb').forEach(function(t){ t.classList.remove('active'); });
              this.classList.add('active');
            "
          >
            <img
              src="{{ image | image_url: width: 120 }}"
              alt="{{ image.alt | default: product.title | escape }}"
              loading="lazy"
              width="80"
              height="80"
            >
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Main Image -->
    <div class="product-page__main-image">
      {% if featured %}
        <img
          id="product-main-img"
          srcset="
            {{ featured | image_url: width: 600 }} 600w,
            {{ featured | image_url: width: 900 }} 900w,
            {{ featured | image_url: width: 1200 }} 1200w
          "
          sizes="(max-width: 900px) 100vw, 50vw"
          src="{{ featured | image_url: width: 1200 }}"
          alt="{{ featured.alt | default: product.title | escape }}"
          loading="eager"
          width="{{ featured.width }}"
          height="{{ featured.height }}"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </div>

  <!-- ==========================================
       PRODUCT INFO — Sticky sidebar
       ========================================== -->
  <div class="product-page__info">
    <!-- Breadcrumb -->
    <nav class="product-page__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">›</span>
      {% if related_collection %}
        <a href="{{ related_collection.url }}">{{ related_collection.title | escape }}</a>
        <span aria-hidden="true">›</span>
      {% endif %}
      <span>{{ product.title | truncate: 40 | escape }}</span>
    </nav>

    {% if product.vendor != blank %}
      <div class="product-page__vendor">{{ product.vendor | escape }}</div>
    {% endif %}

    <h1 class="product-page__title">{{ product.title | escape }}</h1>

    <p class="product-page__promise-row">
      {% if current_variant.available %}
        <span id="pdp-stock-promise" class="product-page__promise product-page__promise--ok">In stock</span>
      {% else %}
        <span id="pdp-stock-promise" class="product-page__promise product-page__promise--muted">Currently unavailable</span>
      {% endif %}
      <span class="product-page__promise-sep" aria-hidden="true">·</span>
      <span>Ships USA &amp; Canada</span>
      <span class="product-page__promise-sep" aria-hidden="true">·</span>
      <span>30-day returns</span>
    </p>

    <!-- Price -->
    <div class="product-page__price">
      {% if product.compare_at_price_max > product.price %}
        <span class="product-page__price-current product-page__price-current--sale">{{ product.price | money }}</span>
        <span class="product-page__price-compare">{{ product.compare_at_price_max | money }}</span>
        {% assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}
        <span class="product-page__save-badge">Save {{ savings }}%</span>
      {% else %}
        <span class="product-page__price-current">{{ product.price | money }}</span>
      {% endif %}
    </div>

    <!-- Short Description -->
    {% if product.description != blank %}
      <div class="product-page__short-desc">
        {{ product.description | strip_html | truncate: 200 }}
      </div>
    {% endif %}

    <hr class="product-page__divider">

    <!-- Variant Selector -->
    <div class="product-page__add-to-cart">
      {% if product.variants.size > 1 %}
        <div class="product-page__variant-wrap">
          <label for="variant-select" class="product-page__field-label">Option</label>
          <select id="variant-select" class="product-page__select" onchange="syncVariantSelect(this)">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                data-available="{{ variant.available }}"
                data-price="{{ variant.price | money }}"
                {% if variant == current_variant %}selected{% endif %}
              >
                {{ variant.title | escape }} — {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}

      <!-- Quantity + Add to Cart -->
      <div class="product-page__qty-row">
        <div class="product-page__qty-control">
          <button type="button" class="product-page__qty-btn" onclick="var q=document.getElementById('pdp-qty');q.value=Math.max(1,parseInt(q.value)-1);" aria-label="Decrease quantity">−</button>
          <input type="number" id="pdp-qty" value="1" min="1" class="product-page__qty-input" aria-label="Quantity">
          <button type="button" class="product-page__qty-btn" onclick="var q=document.getElementById('pdp-qty');q.value=parseInt(q.value)+1;" aria-label="Increase quantity">+</button>
        </div>
        <form action="{{ routes.cart_add_url }}" method="post" style="flex:1;">
          <input type="hidden" name="id" id="atc-variant-id" value="{{ current_variant.id }}">
          <input type="hidden" name="return_to" value="/cart">
          <input type="hidden" name="quantity" id="atc-qty" value="1">
          <button class="btn btn--primary btn--full product-page__atc-btn" type="submit"
                  onclick="document.getElementById('atc-qty').value=document.getElementById('pdp-qty').value;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/></svg>
            Add to Cart
          </button>
        </form>
      </div>

      <!-- Buy Now -->
      <form action="{{ routes.cart_add_url }}" method="post" class="product-page__buy-now-form">
        <input type="hidden" name="id" id="buy-now-variant-id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="return_to" value="/checkout">
        <button type="submit" id="pdp-buy-now-btn" class="btn btn--secondary btn--full product-page__buy-now-btn">
          Buy Now — {{ current_variant.price | money }}
        </button>
      </form>
    </div>

    <script>
      function syncVariantSelect(sel) {
        var opt = sel.options[sel.selectedIndex];
        var variantId = sel.value;
        var atcId = document.getElementById('atc-variant-id');
        var buyId = document.getElementById('buy-now-variant-id');
        if (atcId) atcId.value = variantId;
        if (buyId) buyId.value = variantId;
        var stock = document.getElementById('pdp-stock-promise');
        if (stock && opt) {
          var ok = opt.getAttribute('data-available') === 'true';
          stock.textContent = ok ? 'In stock' : 'Currently unavailable';
          stock.className = 'product-page__promise ' + (ok ? 'product-page__promise--ok' : 'product-page__promise--muted');
        }
        var buyBtn = document.getElementById('pdp-buy-now-btn');
        if (buyBtn && opt && opt.getAttribute('data-price')) {
          buyBtn.textContent = 'Buy Now — ' + opt.getAttribute('data-price');
        }
      }
    </script>

    <!-- Trust Badges -->
    <div class="product-page__trust">
      <div class="product-page__trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <div>
          <strong>Free Shipping</strong>
          <span>Orders $50+</span>
        </div>
      </div>
      <div class="product-page__trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div>
          <strong>Secure Checkout</strong>
          <span>SSL Encrypted</span>
        </div>
      </div>
      <div class="product-page__trust-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        <div>
          <strong>30-Day Returns</strong>
          <span>Money back</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================
     DESCRIPTION TABS
     ========================================== -->
{% if product.description != blank %}
  <div class="product-tabs">
    <div class="container">
      <div class="product-tabs__nav">
        <button class="product-tabs__tab active" onclick="switchTab(this, 'tab-desc')">Description</button>
        <button class="product-tabs__tab" onclick="switchTab(this, 'tab-details')">Details</button>
        <button class="product-tabs__tab" onclick="switchTab(this, 'tab-shipping')">Shipping & Returns</button>
      </div>

      <div id="tab-desc" class="product-tabs__panel active">
        <div class="product-page__description">
          {{ product.description }}
        </div>
      </div>

      <div id="tab-details" class="product-tabs__panel">
        <div class="product-tabs__details">
          {% if product.vendor != blank %}
            <div class="product-tabs__detail-row">
              <span class="product-tabs__detail-label">Brand</span>
              <span class="product-tabs__detail-value">{{ product.vendor | escape }}</span>
            </div>
          {% endif %}
          {% if product.type != blank %}
            <div class="product-tabs__detail-row">
              <span class="product-tabs__detail-label">Category</span>
              <span class="product-tabs__detail-value">{{ product.type | escape }}</span>
            </div>
          {% endif %}
          {% if product.tags.size > 0 %}
            <div class="product-tabs__detail-row product-tabs__detail-row--tags">
              <span class="product-tabs__detail-label">Highlights</span>
              <span class="product-tabs__detail-value">{{ product.tags | join: ', ' | escape }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      <div id="tab-shipping" class="product-tabs__panel">
        <div class="product-tabs__shipping">
          <div class="product-tabs__shipping-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <div>
              <strong>Free Standard Shipping</strong>
              <p>Free on all orders over $50. Typically arrives in 5–7 business days.</p>
            </div>
          </div>
          <div class="product-tabs__shipping-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
            <div>
              <strong>30-Day Returns</strong>
              <p>Not happy? Return within 30 days for a full refund — no questions asked.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<!-- ==========================================
     RELATED PRODUCTS
     ========================================== -->
{% if related_collection != blank and related_collection.products_count > 1 %}
  <div class="related-products">
    <div class="container">
      <div class="section-header section-header--centered">
        <div class="section-header__text">
          <div class="section-header__eyebrow">You May Also Like</div>
          <h2 class="section-header__title">Related Products</h2>
        </div>
      </div>
      <div class="product-grid product-grid--4">
        {% assign shown = 0 %}
        {% for related_product in related_collection.products limit: 5 %}
          {% unless related_product.id == product.id %}
            {% if shown < 4 %}
              {% render 'product-card', product: related_product %}
              {% assign shown = shown | plus: 1 %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      </div>
      <div class="related-products__cta">
        <a href="{{ related_collection.url }}" class="btn btn--secondary btn--icon-right">
          View All in {{ related_collection.title | escape }}
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
{% endif %}

<script>
  function switchTab(btn, panelId) {
    var tabs = btn.closest('.product-tabs__nav').querySelectorAll('.product-tabs__tab');
    var panels = btn.closest('.product-tabs').querySelectorAll('.product-tabs__panel');
    tabs.forEach(function(t) { t.classList.remove('active'); });
    panels.forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById(panelId).classList.add('active');
  }
</script>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
