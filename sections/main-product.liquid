{% liquid
  assign featured = product.featured_image
%}

<div class="product-page">
  <!-- Gallery -->
  <div class="product-page__gallery">
    <div class="product-page__main-image">
      {% if featured %}
        <img
          id="product-main-img"
          srcset="
            {{ featured | image_url: width: 600 }} 600w,
            {{ featured | image_url: width: 900 }} 900w,
            {{ featured | image_url: width: 1200 }} 1200w
          "
          sizes="(max-width: 900px) 100vw, 50vw"
          src="{{ featured | image_url: width: 1200 }}"
          alt="{{ featured.alt | escape }}"
          loading="eager"
          width="{{ featured.width }}"
          height="{{ featured.height }}"
        >
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product-page__thumbnails">
        {% for image in product.images limit: 4 %}
          <div class="product-page__thumbnail {% if forloop.first %}active{% endif %}"
               onclick="document.getElementById('product-main-img').src='{{ image | image_url: width: 1200 }}';
                        document.querySelectorAll('.product-page__thumbnail').forEach(function(t){t.classList.remove('active')});
                        this.classList.add('active');">
            <img
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Product Info -->
  <div class="product-page__info">
    {% if product.vendor != blank %}
      <div class="product-page__vendor">{{ product.vendor | escape }}</div>
    {% endif %}

    <h1 class="product-page__title">{{ product.title | escape }}</h1>

    <div class="product-page__price">
      {% if product.compare_at_price_max > product.price %}
        <span class="product-page__price-current" style="color:var(--color-sale);">{{ product.price | money }}</span>
        <span class="product-page__price-compare">{{ product.compare_at_price_max | money }}</span>
        {% assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}
        <span class="product-card__badge product-card__badge--sale" style="font-size:12px;padding:3px 8px;">Save {{ savings }}%</span>
      {% else %}
        <span class="product-page__price-current">{{ product.price | money }}</span>
      {% endif %}
    </div>

    <div class="product-page__add-to-cart">
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% if product.variants.size > 1 %}
          <div style="margin-bottom:var(--space-md);">
            <label for="variant-select" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-sm);">
              Option
            </label>
            <select id="variant-select" name="id" style="width:100%;padding:12px 14px;border:1px solid var(--color-border);font-family:var(--font-body);font-size:var(--font-size-base);outline:none;background:var(--color-bg);">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title | escape }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        <div style="display:flex;gap:var(--space-sm);">
          <div style="display:flex;align-items:center;border:1px solid var(--color-border);">
            <button type="button" onclick="var q=document.getElementById('qty');q.value=Math.max(1,parseInt(q.value)-1);" style="padding:12px 16px;font-size:18px;cursor:pointer;background:none;border:none;">−</button>
            <input type="number" id="qty" name="quantity" value="1" min="1" style="width:50px;text-align:center;border:none;border-left:1px solid var(--color-border);border-right:1px solid var(--color-border);padding:12px 0;font-family:var(--font-body);font-size:var(--font-size-base);outline:none;">
            <button type="button" onclick="var q=document.getElementById('qty');q.value=parseInt(q.value)+1;" style="padding:12px 16px;font-size:18px;cursor:pointer;background:none;border:none;">+</button>
          </div>
          <button class="btn btn--primary btn--full" type="submit" style="flex:1;">
            Add to Cart
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Trust badges -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-md);margin-bottom:var(--space-xl);padding:var(--space-lg);border:1px solid var(--color-border);">
      <div style="text-align:center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 4px;display:block;"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Free Shipping</div>
        <div style="font-size:11px;color:var(--color-text-secondary);">Orders $50+</div>
      </div>
      <div style="text-align:center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 4px;display:block;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Secure Checkout</div>
        <div style="font-size:11px;color:var(--color-text-secondary);">SSL Encrypted</div>
      </div>
      <div style="text-align:center;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 4px;display:block;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">30-Day Returns</div>
        <div style="font-size:11px;color:var(--color-text-secondary);">Money back</div>
      </div>
    </div>

    {% if product.description != blank %}
      <div class="product-page__description">
        {{ product.description }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
