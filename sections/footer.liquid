{% liquid
  assign social_facebook = settings.social_facebook
  if social_facebook == blank
    assign social_facebook = section.settings.social_facebook
  endif
  assign social_instagram = settings.social_instagram
  if social_instagram == blank
    assign social_instagram = section.settings.social_instagram
  endif
  assign social_tiktok = settings.social_tiktok
  if social_tiktok == blank
    assign social_tiktok = section.settings.social_tiktok
  endif
  assign social_twitter = settings.social_twitter
  if social_twitter == blank
    assign social_twitter = section.settings.social_twitter
  endif
  assign social_youtube = settings.social_youtube
  assign social_pinterest = settings.social_pinterest
%}

<footer class="footer footer--premium">

  <div class="footer__main">

    <!-- Brand Column -->
    <div class="footer__brand">
      <div class="footer__logo">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" class="footer__logo-img" loading="lazy" width="120">
        {% else %}
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" class="footer__logo-img" loading="lazy" width="120">
        {% endif %}
      </div>
      <p class="footer__brand-text">{{ section.settings.tagline | default: 'Premium products for every need — from trending gadgets to everyday essentials, delivered fast.' | escape }}</p>
      <div class="footer__social">
        {% if social_facebook != blank %}<a href="{{ social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg></a>{% endif %}
        {% if social_instagram != blank %}<a href="{{ social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg></a>{% endif %}
        {% if social_tiktok != blank %}<a href="{{ social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg></a>{% endif %}
        {% if social_twitter != blank %}<a href="{{ social_twitter }}" aria-label="X/Twitter" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4l11.733 16h4.267l-11.733-16z"/><path d="M4 20l6.768-6.768M20 4l-6.768 6.768"/></svg></a>{% endif %}
        {% if social_youtube != blank %}<a href="{{ social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31.7 31.7 0 000 12a31.7 31.7 0 00.5 5.8 3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1 31.7 31.7 0 00.5-5.8 31.7 31.7 0 00-.5-5.8zM9.7 15.5V8.4l6.2 3.6-6.2 3.5z"/></svg></a>{% endif %}
      </div>
    </div>

    <!-- Shop Column -->
    <div class="footer__column">
      <h4>Shop</h4>
      <ul>
        <li><a href="/collections/all">All Products</a></li>
        <li><a href="/collections/trending-now">Trending Now</a></li>
        <li><a href="/collections/best-sales">Best Sellers</a></li>
        <li><a href="/collections/new-arrivals">New Arrivals</a></li>
      </ul>
    </div>

    <!-- Support Column -->
    <div class="footer__column">
      <h4>Support</h4>
      <ul>
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/pages/track-order">Track Order</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
      </ul>
    </div>

    <!-- Policies Column -->
    <div class="footer__column">
      <h4>Policies</h4>
      <ul>
        <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        <li><a href="/policies/refund-policy">Refund Policy</a></li>
        <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a href="/policies/terms-of-service">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <!-- Footer Bottom -->
  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.legal | default: 'All rights reserved.' | escape }}
      </div>
      <div class="footer__payments">
        <!-- Visa -->
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" aria-label="Visa"><rect x="0.5" y="0.5" width="37" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><path d="M15.764 16.537h-2.408l1.505-9.303h2.408l-1.505 9.303z" fill="#3C58BF"/><path d="M24.633 7.449c-.475-.188-1.218-.39-2.145-.39-2.367 0-4.034 1.258-4.048 3.06-.028 1.33 1.19 2.073 2.1 2.516.924.452 1.239.747 1.239 1.148-.014.618-.747.9-1.435.9-1.505 0-2.311-.284-3.547-.916l-.047-.024-.52 3.169c.475.215 1.352.404 2.263.418 2.517 0 4.148-1.244 4.162-3.17.014-1.057-.632-1.862-2.016-2.525-.84-.429-1.355-.714-1.355-1.148.014-.396.437-.806 1.382-.806.787-.014 1.359.166 1.8.35l.215.104.52-3.105z" fill="#3C58BF"/><path d="M28.863 7.234h-1.85c-.57 0-1 .166-1.25.77l-3.533 8.533h2.503l.502-1.375 3.055.004c.07.32.29 1.371.29 1.371h2.212L28.863 7.234zm-2.926 6.14c.2-.532 1.077-2.945 1.077-2.945l-.014.028c.07-.18.344-.926.56-1.52l.287 1.37.627 3.068H25.937v-.001z" fill="#3C58BF"/><path d="M12.132 7.234l-2.34 6.346-.256-1.285c-.437-1.493-1.8-3.115-3.324-3.925l2.131 8.154h2.531l3.769-9.29h-2.511z" fill="#3C58BF"/><path d="M8.109 7.234H4.34l-.034.18c3.003.764 4.993 2.613 5.815 4.834l-.84-4.244c-.145-.59-.57-.756-1.173-.77z" fill="#E8A723"/></svg>
        <!-- Mastercard -->
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg" aria-label="Mastercard"><rect x="0.5" y="0.5" width="37" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.2a7 7 0 012.8 4.8 7 7 0 01-2.8 4.8 7 7 0 01-2.8-4.8A7 7 0 0119 7.2z" fill="#FF5F00"/></svg>
