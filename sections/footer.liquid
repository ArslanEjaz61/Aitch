      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Premium products for every need — from trending gadgets to everyday essentials, delivered fast."
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line",
      "default": "All rights reserved."
    },
    {
      "type": "paragraph",
      "content": "Social icons use Theme settings → Social & trust first. URLs below are optional fallbacks."
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook (fallback)"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram (fallback)"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok (fallback)"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X / Twitter (fallback)"
    }
  ]
}
{% endschema %}
