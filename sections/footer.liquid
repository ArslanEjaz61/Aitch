        <!-- Google Pay -->
        <svg viewBox="0 0 50 24" width="50" height="24" xmlns="http://www.w3.org/2000/svg" aria-label="Google Pay"><rect x="0.5" y="0.5" width="49" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><path d="M23.5 12.1v2.8h-.9V8.2h2.4c.6 0 1.1.2 1.5.6.4.4.7.9.7 1.5 0 .6-.2 1.1-.7 1.5-.4.4-1 .6-1.5.6h-1.5zm0-3.1v2.4h1.5c.4 0 .7-.1.9-.4.2-.2.4-.5.4-.8 0-.3-.1-.6-.4-.8-.2-.2-.6-.4-.9-.4h-1.5zM29.2 10.4c.6 0 1.1.2 1.5.5.4.3.5.8.5 1.5v3h-.9v-.7h0c-.4.6-.9.9-1.6.9-.6 0-1-.2-1.4-.5-.4-.3-.6-.7-.6-1.2 0-.5.2-.9.6-1.2.4-.3.9-.4 1.6-.4.6 0 1 .1 1.4.3v-.2c0-.4-.1-.7-.4-1-.3-.3-.6-.4-1-.4-.6 0-1 .2-1.3.7l-.8-.5c.4-.7 1.1-1 2-1zm-.3 5c.3 0 .6-.1.9-.3.3-.2.4-.5.4-.8 0-.3-.1-.5-.4-.7-.2-.2-.5-.3-.9-.3-.4 0-.8.1-1 .3-.3.2-.4.5-.4.8 0 .3.1.5.4.7.3.2.6.3 1 .3zM34.4 10.4l-2.3 5.4h-.9l.9-1.9-1.6-3.5h1l1.1 2.7h0l1-2.7h.8z" fill="#3C4043"/><path d="M17.1 12.4c0-.3 0-.6-.1-.9h-3.7v1.7h2.1c-.1.5-.4 1-.7 1.3v1h1.2c.7-.7 1.2-1.7 1.2-3.1z" fill="#4285F4"/><path d="M13.3 16.5c1.1 0 2-.4 2.7-1l-1.2-1c-.4.3-.8.4-1.5.4-1.1 0-2-.7-2.3-1.8h-1.3v1c.7 1.4 2.1 2.4 3.6 2.4z" fill="#34A853"/><path d="M11 13.1c-.1-.4-.1-.7-.1-1.1 0-.4 0-.7.1-1.1v-1H9.6c-.3.7-.5 1.4-.5 2.1s.2 1.5.5 2.1l1.4-1z" fill="#FBBC05"/><path d="M13.3 10.2c.6 0 1.2.2 1.6.6l1.1-1.1c-.7-.6-1.6-1-2.7-1-1.5 0-2.9 1-3.6 2.4l1.4 1c.3-1.1 1.2-1.9 2.2-1.9z" fill="#EA4335"/></svg>
        <!-- PayPal -->
        <svg viewBox="0 0 50 24" width="50" height="24" xmlns="http://www.w3.org/2000/svg" aria-label="PayPal"><rect x="0.5" y="0.5" width="49" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><path d="M20.5 8H17c-.2 0-.4.2-.5.4l-1.4 9c0 .2.1.4.3.4h1.7c.2 0 .4-.2.5-.4l.4-2.5c0-.2.2-.4.5-.4h1.1c2.3 0 3.7-1.1 4-3.3.2-.9 0-1.7-.5-2.2-.5-.7-1.4-1-2.6-1zm.4 3.3c-.2 1.3-1.1 1.3-2 1.3h-.5l.4-2.3c0-.1.1-.2.3-.2h.2c.6 0 1.2 0 1.4.3.2.3.2.6.2.9z" fill="#003087"/><path d="M29.5 11.3H27.8c-.2 0-.3.1-.3.2l-.1.5-.1-.2c-.4-.5-1.2-.7-2-.7-1.8 0-3.4 1.4-3.7 3.3-.2 1 .1 1.9.6 2.5.5.6 1.3.8 2.2.8 1.5 0 2.3-1 2.3-1l-.1.5c0 .2.1.4.3.4h1.5c.2 0 .4-.2.5-.4l.9-5.5c0-.3-.2-.4-.3-.4zm-2.4 3.3c-.2.9-.8 1.5-1.7 1.5-.4 0-.8-.1-1-.4-.2-.3-.3-.6-.3-1.1.1-.9.8-1.5 1.7-1.5.4 0 .8.1 1 .4.2.3.3.7.3 1.1z" fill="#003087"/><path d="M34.5 11.3H32.8c-.2 0-.3.1-.4.2l-2.4 3.6-1-3.5c-.1-.2-.3-.3-.5-.3H26.8c-.2 0-.4.2-.3.5l1.9 5.5-1.7 2.4c-.2.2 0 .5.3.5h1.7c.2 0 .3-.1.4-.2l5.5-8c.1-.3-.1-.7-.1-.7z" fill="#009CDE"/></svg>
