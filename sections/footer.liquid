<footer class="footer">
  <div class="footer__main">
    <!-- Brand Column -->
    <div class="footer__brand">
      <div class="footer__logo">
        {% if settings.logo != blank %}
          <img
            class="header__logo-img"
            src="{{ settings.logo | image_url: width: 140 }}"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            width="140"
            height="auto"
            style="max-height:32px;width:auto;"
          >
        {% else %}
          <img
            class="header__logo-img"
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            width="140"
            height="auto"
            style="max-height:32px;width:auto;"
          >
        {% endif %}
        <span class="footer__logo-text">{{ section.settings.brand_text | default: shop.name | escape }}</span>
      </div>
      <p class="footer__brand-text">{{ section.settings.tagline | default: 'Simple solutions for everyday home problems. Curated cleaning tools, kitchen essentials, and home convenience products — shipped fast across North America.' | escape }}</p>

      <div class="footer__social">
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/></svg>
          </a>
        {% endif %}
        {% if section.settings.social_tiktok != blank %}
          <a href="{{ section.settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
          </a>
        {% endif %}
        {% if section.settings.social_twitter != blank %}
          <a href="{{ section.settings.social_twitter }}" aria-label="X / Twitter" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M4 4l11.733 16h4.267l-11.733-16z"/><path d="M4 20l6.768-6.768M20 4l-6.768 6.768"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Footer Menu Columns — uses Shopify Menus (linklists) -->
    {% assign footer_menu_1 = linklists[section.settings.footer_menu_1] %}
    {% assign footer_menu_2 = linklists[section.settings.footer_menu_2] %}
    {% assign footer_menu_3 = linklists[section.settings.footer_menu_3] %}

    {% if footer_menu_1.links.size > 0 %}
      <div class="footer__column">
        <h4>{{ footer_menu_1.title | escape }}</h4>
        <ul>
          {% for link in footer_menu_1.links %}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if footer_menu_2.links.size > 0 %}
      <div class="footer__column">
        <h4>{{ footer_menu_2.title | escape }}</h4>
        <ul>
          {% for link in footer_menu_2.links %}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if footer_menu_3.links.size > 0 %}
      <div class="footer__column">
        <h4>{{ footer_menu_3.title | escape }}</h4>
        <ul>
          {% for link in footer_menu_3.links %}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>

  <!-- Footer Bottom -->
  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ section.settings.legal | default: 'All rights reserved.' | escape }}
      </div>
      <div class="footer__payments">
        <!-- Visa -->
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="37" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><path d="M15.764 16.537h-2.408l1.505-9.303h2.408l-1.505 9.303z" fill="#3C58BF"/><path d="M24.633 7.449c-.475-.188-1.218-.39-2.145-.39-2.367 0-4.034 1.258-4.048 3.06-.028 1.33 1.19 2.073 2.1 2.516.924.452 1.239.747 1.239 1.148-.014.618-.747.9-1.435.9-1.505 0-2.311-.284-3.547-.916l-.047-.024-.52 3.169c.475.215 1.352.404 2.263.418 2.517 0 4.148-1.244 4.162-3.17.014-1.057-.632-1.862-2.016-2.525-.84-.429-1.355-.714-1.355-1.148.014-.396.437-.806 1.382-.806.787-.014 1.359.166 1.8.35l.215.104.52-3.105-.014.014-.014-.001z" fill="#3C58BF"/><path d="M28.863 7.234h-1.85c-.57 0-1 .166-1.25.77l-3.533 8.533h2.503l.502-1.375 3.055.004c.07.32.29 1.371.29 1.371h2.212L28.863 7.234zm-2.926 6.14c.2-.532 1.077-2.945 1.077-2.945l-.014.028c.07-.18.344-.926.56-1.52l.287 1.37.627 3.068H25.937v-.001z" fill="#3C58BF"/><path d="M12.132 7.234l-2.34 6.346-.256-1.285c-.437-1.493-1.8-3.115-3.324-3.925l2.131 8.154h2.531l3.769-9.29h-2.511z" fill="#3C58BF"/><path d="M8.109 7.234H4.34l-.034.18c3.003.764 4.993 2.613 5.815 4.834l-.84-4.244c-.145-.59-.57-.756-1.173-.77z" fill="#E8A723"/></svg>
        <!-- Mastercard -->
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="37" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 7.2a7 7 0 012.8 4.8 7 7 0 01-2.8 4.8 7 7 0 01-2.8-4.8A7 7 0 0119 7.2z" fill="#FF5F00"/></svg>
        <!-- PayPal -->
        <svg viewBox="0 0 38 24" width="38" height="24" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" y="0.5" width="37" height="23" rx="3" fill="#fff" stroke="#d9d9d9"/><path fill-rule="evenodd" clip-rule="evenodd" d="M19.658 15.35c-.338-.288-.612-.574-.89-.862l-.14.862H16.08l1.5-9.3h2.408l-.748 4.556c.35-.378.77-.84 1.37-1.218.596-.378 1.282-.574 2.05-.574.896 0 1.602.28 2.12.84.52.562.77 1.342.77 2.344 0 .378-.046.764-.14 1.148-.188.858-.52 1.604-.98 2.232-.456.628-1.002 1.092-1.627 1.394-.626.302-1.267.448-1.917.448-.854 0-1.472-.224-1.862-.673l-.396-.197zm2.212-1.54c.334-.194.608-.45.82-.77.214-.318.376-.67.484-1.054.082-.28.124-.556.124-.826 0-.438-.112-.786-.332-1.044-.222-.258-.534-.388-.936-.388-.376 0-.738.136-1.082.41-.346.272-.622.654-.828 1.148-.17.404-.268.818-.292 1.242-.018.28.034.538.156.774.122.234.3.416.536.546.236.128.516.194.838.194.178 0 .34-.024.488-.072l.024-.16z" fill="#009EE3"/></svg>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "Aitch Home Care"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Simple solutions for everyday home problems. Curated cleaning tools, kitchen essentials, and home convenience products — shipped fast across North America."
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal line",
      "default": "All rights reserved."
    },
    {
      "type": "header",
      "content": "Footer menus"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Footer menu 1 (e.g. Shop)",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Footer menu 2 (e.g. Support)"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Footer menu 3 (e.g. Company)"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X / Twitter URL"
    }
  ]
}
{% endschema %}
