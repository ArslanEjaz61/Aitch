<div class="cart-page">

  <!-- Cart Header -->
  <div class="cart-page__header">
    <div>
      <h1 class="cart-page__title">Shopping Cart</h1>
      {% if cart.item_count > 0 %}
        <p class="cart-page__count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</p>
      {% endif %}
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue-link">
      <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Continue Shopping
    </a>
  </div>

  {% if cart.item_count == 0 %}
    <!-- Empty Cart -->
    <div class="cart-empty">
      <div class="cart-empty__icon">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/></svg>
      </div>
      <h2 class="cart-empty__title">Your cart is empty</h2>
      <p class="cart-empty__text">Looks like you haven't added anything yet. Browse our products and find your perfect solution.</p>
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
        Shop Now
      </a>
    </div>

  {% else %}
    <div class="cart-layout">
      <form action="{{ routes.cart_url }}" method="post" novalidate id="cart-form" class="cart-layout__form">

        <!-- Cart Items Column -->
        <div class="cart-items-col">
          <div class="cart-items-list">
            {% for item in cart.items %}
              <div class="cart-item">

                <!-- Product Image -->
                <a class="cart-item__image" href="{{ item.url }}">
                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 240 }}"
                      alt="{{ item.image.alt | default: item.product.title | escape }}"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% elsif item.product.featured_image %}
                    <img
                      src="{{ item.product.featured_image | image_url: width: 240 }}"
                      alt="{{ item.product.title | escape }}"
                      loading="lazy"
                      width="120"
                      height="120"
                    >
                  {% else %}
                    <div class="cart-item__image-placeholder">
                      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                  {% endif %}
                </a>

                <!-- Product Info -->
                <div class="cart-item__info">
                  <div class="cart-item__top">
                    <div>
                      {% if item.product.vendor != blank %}
                        <div class="cart-item__vendor">{{ item.product.vendor | escape }}</div>
                      {% endif %}
                      <h3 class="cart-item__title">
                        <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      </h3>
                      {% if item.variant.title != 'Default Title' %}
                        <div class="cart-item__variant">{{ item.variant.title | escape }}</div>
                      {% endif %}
                    </div>
                    <!-- Price (desktop) -->
                    <div class="cart-item__price-desktop">
                      {% if item.original_line_price > item.final_line_price %}
                        <div class="cart-item__price-sale">{{ item.final_line_price | money }}</div>
                        <div class="cart-item__price-compare">{{ item.original_line_price | money }}</div>
                      {% else %}
                        <div class="cart-item__price-current">{{ item.final_line_price | money }}</div>
                      {% endif %}
                      <div class="cart-item__unit-price">{{ item.price | money }} each</div>
                    </div>
                  </div>

                  <!-- Quantity + Remove -->
                  <div class="cart-item__controls">
                    <div class="cart-item__qty-wrap">
                      <button type="button" class="cart-item__qty-btn"
                        onclick="var i=this.nextElementSibling; i.value=Math.max(1,parseInt(i.value)-1); i.dispatchEvent(new Event('change', {bubbles:true}));"
                        aria-label="Decrease">−</button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="1"
                        data-line="{{ forloop.index }}"
                        class="cart-item__qty-input"
                        aria-label="Quantity for {{ item.product.title | escape }}"
                      >
                      <button type="button" class="cart-item__qty-btn"
                        onclick="var i=this.previousElementSibling; i.value=parseInt(i.value)+1; i.dispatchEvent(new Event('change', {bubbles:true}));"
                        aria-label="Increase">+</button>
                    </div>

                    <a class="cart-item__remove-btn"
                       href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                       onclick="event.preventDefault(); window.updateCartQuantity({{ forloop.index }}, 0);"
                       aria-label="Remove {{ item.product.title | escape }}">
                      <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                      Remove
                    </a>

                    <!-- Price (mobile) -->
                    <div class="cart-item__price-mobile">
                      {% if item.original_line_price > item.final_line_price %}
                        <span class="cart-item__price-sale">{{ item.final_line_price | money }}</span>
                      {% else %}
                        <span class="cart-item__price-current">{{ item.final_line_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>

              </div>
            {% endfor %}
          </div>

          <!-- Update Cart (Hidden, kept for fallback) -->
          <div class="cart-update-row" style="display: none;">
            <button class="btn btn--secondary" type="submit" name="update">Update Cart</button>
          </div>
        </div>

        <!-- Order Summary Column -->
        <aside class="cart-summary">
          <h2 class="cart-summary__title">Order Summary</h2>

          <div class="cart-summary__lines">
            {% for item in cart.items %}
              <div class="cart-summary__line">
                <span class="cart-summary__line-name">
                  {{ item.product.title | truncate: 32 | escape }}
                  <span class="cart-summary__line-qty">×{{ item.quantity }}</span>
                </span>
                <span class="cart-summary__line-price">{{ item.final_line_price | money }}</span>
              </div>
            {% endfor %}
          </div>

          <div class="cart-summary__divider"></div>

          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span class="cart-summary__value">{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row cart-summary__row--secondary">
            <span>Shipping</span>
            <span>Calculated at checkout</span>
          </div>
          {% if cart.total_discounts > 0 %}
            <div class="cart-summary__row cart-summary__row--discount">
              <span>Discounts</span>
              <span>−{{ cart.total_discounts | money }}</span>
            </div>
          {% endif %}

          <div class="cart-summary__total-row">
            <span>Total</span>
            <span class="cart-summary__total-price">{{ cart.total_price | money }}</span>
          </div>

          <p class="cart-summary__note">Taxes and shipping calculated at checkout.</p>

          <button class="btn btn--primary btn--full cart-summary__checkout-btn" type="submit" name="checkout">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Proceed to Checkout
          </button>

          <div class="cart-summary__trust">
            <div class="cart-summary__trust-item">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              SSL Secure Checkout
            </div>
            <div class="cart-summary__trust-item">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
              30-Day Free Returns
            </div>
          </div>
        </aside>
      </form>
    </div>
  {% endif %}
</div>

<script>
  window.updateCartQuantity = function(line, quantity) {
    const cartPage = document.querySelector('.cart-page');
    if (!cartPage) return;

    cartPage.classList.add('is-loading');

    // Use /cart/change.js to update the quantity
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, quantity: parseInt(quantity) })
    })
    .then(response => {
      if (!response.ok) throw new Error('Cart update failed');
      return response.json();
    })
    .then(cart => {
      // Use Section Rendering API to get updated cart HTML
      // We use the section file name 'main-cart' as the key
      return fetch(window.location.pathname + '?sections=main-cart');
    })
    .then(response => response.json())
    .then(sections => {
      const sectionHtml = sections['main-cart'];
      if (!sectionHtml) throw new Error('Section main-cart not found in response');

      const html = new DOMParser().parseFromString(sectionHtml, 'text/html');
      const newInner = html.querySelector('.cart-page').innerHTML;
      
      // Update the DOM
      cartPage.innerHTML = newInner;
      cartPage.classList.remove('is-loading');

      // Update header cart count
      const newCount = document.querySelector('.cart-page__count'); // We can get it from the new HTML too
      const headerCountEl = document.querySelector('.header__cart-count');
      if (headerCountEl) {
          fetch('/cart.js').then(res => res.json()).then(cart => {
            if (cart.item_count > 0) {
              headerCountEl.textContent = cart.item_count;
              headerCountEl.style.display = 'flex';
            } else {
              headerCountEl.style.display = 'none';
            }
          });
      }
    })
    .catch(error => {
      console.error('Error updating cart:', error);
      cartPage.classList.remove('is-loading');
      // If AJAX fails, fallback to full page reload to ensure consistency
      window.location.reload();
    });
  };

  // Delegate change event for quantity inputs
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('cart-item__qty-input')) {
      const line = e.target.getAttribute('data-line');
      const quantity = e.target.value;
      window.updateCartQuantity(line, quantity);
    }
  });
</script>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}


