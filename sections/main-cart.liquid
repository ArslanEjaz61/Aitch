<div class="cart-page">
  <div class="cart-page__header">
    <h1 class="cart-page__title">Your Cart</h1>
  </div>

  {% if cart.item_count == 0 %}
    <div class="empty-state">
      <div class="empty-state__icon">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </div>
      <h3 class="empty-state__title">Your cart is empty</h3>
      <p class="empty-state__text">Looks like you haven't found the right solution yet. Browse our products and find the perfect fix.</p>
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
    </div>
  {% else %}
    <div class="cart-layout">
      <!-- Cart Items -->
      <div>
        <form action="{{ routes.cart_url }}" method="post" novalidate>
          {% for item in cart.items %}
            <div class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 300 }}"
                    alt="{{ item.image.alt | escape }}"
                    loading="lazy"
                    width="{{ item.image.width }}"
                    height="{{ item.image.height }}"
                  >
                {% endif %}
              </a>

              <div>
                <h2 class="cart-item__title">
                  <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                </h2>
                {% if item.variant.title != 'Default Title' %}
                  <div class="cart-item__variant">{{ item.variant.title | escape }}</div>
                {% endif %}
                <div class="cart-item__quantity">
                  <label class="sr-only" for="qty-{{ item.key }}">Quantity</label>
                  <input
                    id="qty-{{ item.key }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                  >
                  <a class="cart-item__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                </div>
              </div>

              <div class="cart-item__price">
                <div class="cart-item__price-current">{{ item.final_line_price | money }}</div>
                {% if item.original_line_price > item.final_line_price %}
                  <div class="cart-item__price-compare">{{ item.original_line_price | money }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}

          <div style="display:flex;gap:var(--space-sm);margin-top:var(--space-lg);">
            <button class="btn btn--secondary" type="submit" name="update">Update Cart</button>
            <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
          </div>
        </form>
      </div>

      <!-- Cart Summary -->
      <aside class="cart-summary">
        <h2 class="cart-summary__title">Order Summary</h2>

        <div class="cart-summary__row">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <div class="cart-summary__row">
          <span>Shipping</span>
          <span style="color:var(--color-text-secondary)">Calculated at checkout</span>
        </div>

        <div class="cart-summary__row cart-summary__row--total">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <p class="cart-summary__note">Shipping and taxes calculated at checkout.</p>

        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--primary btn--full" type="submit" name="checkout">
            Checkout
          </button>
        </form>

        <div style="text-align:center;margin-top:var(--space-md);">
          <a class="btn btn--link" href="{{ routes.root_url }}">← Back to Home</a>
        </div>
      </aside>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
