      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_3_title | default: 'Free Shipping $50+' | escape }}</strong>
        <span>{{ section.settings.trust_3_text | default: 'Fast delivery across North America' | escape }}</span>
      </div>
    </div>
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
        <svg viewBox="0 0 24 24"><path d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68L23 12z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_4_title | default: '30-Day Returns' | escape }}</strong>
        <span>{{ section.settings.trust_4_text | default: 'Hassle-free money back guarantee' | escape }}</span>
      </div>
    </div>
