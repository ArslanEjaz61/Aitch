{% liquid
  assign hero_image = section.settings.hero_image
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 8
%}

<!-- ============================
     HERO SECTION — Atlas Split
     ============================ -->
<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__eyebrow fade-in">
        <span class="hero__eyebrow-dot"></span>
        <span>{{ section.settings.kicker | default: 'Smart home solutions — delivered' | escape }}</span>
      </div>

      <h1 class="hero__heading fade-in fade-in-delay-1">{{ section.settings.heading | default: 'Solve everyday home problems. Effortlessly.' | escape }}</h1>

      <p class="hero__description fade-in fade-in-delay-2">{{ section.settings.subheading | default: 'Premium cleaning tools, kitchen essentials, and home convenience products — curated for everyday wins.' | escape }}</p>

      <div class="hero__actions fade-in fade-in-delay-3">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="btn btn--primary btn--icon-right" href="{{ section.settings.primary_link }}">
            <span>{{ section.settings.primary_label | escape }}</span>
            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="btn btn--secondary" href="{{ section.settings.secondary_link }}">
            <span>{{ section.settings.secondary_label | escape }}</span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="hero__media">
      {% if hero_image != blank %}
        <img
          srcset="
            {{ hero_image | image_url: width: 800 }} 800w,
            {{ hero_image | image_url: width: 1200 }} 1200w,
            {{ hero_image | image_url: width: 1600 }} 1600w
          "
          sizes="(max-width: 900px) 100vw, 50vw"
          src="{{ hero_image | image_url: width: 1200 }}"
          alt="{{ hero_image.alt | default: 'Aitch Home Care — Home Solutions' | escape }}"
          loading="eager"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
          fetchpriority="high"
        >
      {% else %}
        <img
          src="{{ 'hero.png' | asset_url }}"
          alt="Aitch Home Care — Premium Home Solutions"
          loading="eager"
          width="1200"
          height="auto"
          fetchpriority="high"
          style="object-fit: cover; width: 100%; height: 100%;"
        >
      {% endif %}
    </div>
  </div>

  <!-- Stats Bar -->
  <div class="hero__stats">
    <div class="hero__stat">
      <div class="hero__stat-value">{{ section.settings.stat_1_value | default: '20+' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_1_label | default: 'Curated Products' | escape }}</div>
    </div>
    <div class="hero__stat">
      <div class="hero__stat-value">{{ section.settings.stat_2_value | default: '2-5 Day' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_2_label | default: 'Fast Shipping' | escape }}</div>
    </div>
    <div class="hero__stat">
      <div class="hero__stat-value">{{ section.settings.stat_3_value | default: '30 Day' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_3_label | default: 'Easy Returns' | escape }}</div>
    </div>
  </div>
</section>

<!-- ============================
     TRUST BAR
     ============================ -->
<section class="trust-bar reveal">
  <div class="trust-bar__inner">
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
        <svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>
      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_1_title | default: 'Problem-Solving Tools' | escape }}</strong>
        <span>{{ section.settings.trust_1_text | default: 'Every product solves a real home problem' | escape }}</span>
      </div>
    </div>
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_2_title | default: 'Quality Guaranteed' | escape }}</strong>
        <span>{{ section.settings.trust_2_text | default: 'Tested and trusted by thousands' | escape }}</span>
      </div>
    </div>
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_3_title | default: 'Free Shipping $50+' | escape }}</strong>
        <span>{{ section.settings.trust_3_text | default: 'Fast delivery across North America' | escape }}</span>
      </div>
    </div>
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
        <svg viewBox="0 0 24 24"><path d="M23 12l-2.44-2.78.34-3.68-3.61-.82-1.89-3.18L12 3 8.6 1.54 6.71 4.72l-3.61.81.34 3.68L1 12l2.44 2.78-.34 3.69 3.61.82 1.89 3.18L12 21l3.4 1.46 1.89-3.18 3.61-.82-.34-3.68L23 12z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_4_title | default: '30-Day Returns' | escape }}</strong>
        <span>{{ section.settings.trust_4_text | default: 'Hassle-free money back guarantee' | escape }}</span>
      </div>
    </div>
  </div>
</section>

<!-- ============================
     FEATURED PRODUCTS GRID
     ============================ -->
<section class="section-spacing reveal">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <div class="section-header__eyebrow">{{ section.settings.grid_eyebrow | default: 'Featured' | escape }}</div>
        <h2 class="section-header__title">{{ section.settings.grid_heading | default: 'Best-Selling Solutions' | escape }}</h2>
        <p class="section-header__subtitle">{{ section.settings.grid_subheading | default: 'Our most popular products that solve everyday home problems.' | escape }}</p>
      </div>
      {% if section.settings.grid_cta_label != blank and section.settings.grid_cta_link != blank %}
        <a class="btn btn--secondary" href="{{ section.settings.grid_cta_link }}">{{ section.settings.grid_cta_label | escape }}</a>
      {% endif %}
    </div>

    {% if collection != blank and collection.products_count > 0 %}
      <div class="product-grid product-grid--4">
        {% for product in collection.products limit: product_limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <div class="empty-state__icon">
          <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        </div>
        <h3 class="empty-state__title">No products yet</h3>
        <p class="empty-state__text">Select a collection in this section's settings to show featured products.</p>
      </div>
    {% endif %}
  </div>
</section>

<!-- ============================
     COLLECTION BANNER — Cleaning
     ============================ -->
<section class="collection-banner reveal">
  <div class="collection-banner__content">
    <div class="collection-banner__eyebrow">{{ section.settings.banner_1_eyebrow | default: 'Top Category' | escape }}</div>
    <h2 class="collection-banner__heading">{{ section.settings.banner_1_heading | default: 'Cleaning Tools' | escape }}</h2>
    <p class="collection-banner__text">{{ section.settings.banner_1_text | default: 'From electric spin brushes to steam cleaners — transform your cleaning routine with tools that actually work.' | escape }}</p>
    {% if section.settings.banner_1_link != blank %}
      <div>
        <a class="btn btn--primary" href="{{ section.settings.banner_1_link }}">{{ section.settings.banner_1_label | default: 'Shop Cleaning' | escape }}</a>
      </div>
    {% endif %}
  </div>
  <div class="collection-banner__media">
    {% if section.settings.banner_1_image != blank %}
      <img
        src="{{ section.settings.banner_1_image | image_url: width: 1200 }}"
        alt="{{ section.settings.banner_1_image.alt | default: 'Cleaning tools collection' | escape }}"
        loading="lazy"
        width="{{ section.settings.banner_1_image.width }}"
        height="{{ section.settings.banner_1_image.height }}"
      >
    {% else %}
      <img
        src="{{ 'banner-cleaning.png' | asset_url }}"
        alt="Cleaning Tools Collection"
        loading="lazy"
        width="1200"
        height="auto"
        style="object-fit: cover; width: 100%; height: 100%;"
      >
    {% endif %}
  </div>
</section>

<!-- ============================
     COLLECTION BANNER — Kitchen (Reversed)
     ============================ -->
<section class="collection-banner collection-banner--reverse reveal">
  <div class="collection-banner__content">
    <div class="collection-banner__eyebrow">{{ section.settings.banner_2_eyebrow | default: 'Kitchen Essentials' | escape }}</div>
    <h2 class="collection-banner__heading">{{ section.settings.banner_2_heading | default: 'Kitchen Problem Solvers' | escape }}</h2>
    <p class="collection-banner__text">{{ section.settings.banner_2_text | default: 'Smart tools that make cooking, organizing and cleaning up faster and easier — from oil sprayers to bag sealers.' | escape }}</p>
    {% if section.settings.banner_2_link != blank %}
      <div>
        <a class="btn btn--primary" href="{{ section.settings.banner_2_link }}">{{ section.settings.banner_2_label | default: 'Shop Kitchen' | escape }}</a>
      </div>
    {% endif %}
  </div>
  <div class="collection-banner__media">
    {% if section.settings.banner_2_image != blank %}
      <img
        src="{{ section.settings.banner_2_image | image_url: width: 1200 }}"
        alt="{{ section.settings.banner_2_image.alt | default: 'Kitchen tools collection' | escape }}"
        loading="lazy"
        width="{{ section.settings.banner_2_image.width }}"
        height="{{ section.settings.banner_2_image.height }}"
      >
    {% else %}
      <img
        src="{{ 'banner-kitchen.png' | asset_url }}"
        alt="Kitchen Problem Solvers"
        loading="lazy"
        width="1200"
        height="auto"
        style="object-fit: cover; width: 100%; height: 100%;"
      >
    {% endif %}
  </div>
</section>

<!-- ============================
     CATEGORIES GRID
     ============================ -->
<section class="section-spacing reveal">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <div class="section-header__eyebrow">{{ section.settings.cats_eyebrow | default: 'Browse' | escape }}</div>
        <h2 class="section-header__title">{{ section.settings.cats_heading | default: 'Shop by Category' | escape }}</h2>
        <p class="section-header__subtitle">{{ section.settings.cats_subtitle | default: 'Find the right solution for every room in your home.' | escape }}</p>
      </div>
    </div>

    <div class="categories-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category' %}
            <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {% liquid
                  assign fallback_img = 'category-cleaning.jpg'
                  if block.settings.title contains 'Kitchen'
                    assign fallback_img = 'category-kitchen.jpg'
                  elsif block.settings.title contains 'Home'
                    assign fallback_img = 'category-home.jpg'
                  endif
                %}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="auto"
                  style="object-fit: cover; width: 100%; height: 100%;"
                >
              {% endif %}
              <div class="category-card__overlay"></div>
              <div class="category-card__content">
                <h3 class="category-card__title">{{ block.settings.title | escape }}</h3>
                <div class="category-card__count">{{ block.settings.subtitle | default: 'Shop now →' | escape }}</div>
              </div>
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================
     TESTIMONIALS
     ============================ -->
<section class="testimonials section-spacing reveal">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <div class="section-header__eyebrow">{{ section.settings.reviews_eyebrow | default: 'Reviews' | escape }}</div>
        <h2 class="section-header__title">{{ section.settings.reviews_heading | default: 'What Our Customers Say' | escape }}</h2>
        <p class="section-header__subtitle">{{ section.settings.reviews_subtitle | default: 'Real feedback from real home problem-solvers.' | escape }}</p>
      </div>
    </div>

    <div class="testimonials-grid">
      <div class="testimonial-card">
        <div class="testimonial-card__stars">
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <p class="testimonial-card__text">"{{ section.settings.review_1_text | default: 'The Electric Spin Brush is a game changer! My bathroom has never been this clean. Saves so much time and effort.' | escape }}"</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">
            <img src="{{ 'user-1.jpg' | asset_url }}" alt="Sarah M." loading="lazy" width="40" height="40" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
          <div>
            <div class="testimonial-card__name">{{ section.settings.review_1_name | default: 'Sarah M.' | escape }}</div>
            <div class="testimonial-card__meta">{{ section.settings.review_1_meta | default: 'Verified Buyer • Texas' | escape }}</div>
          </div>
        </div>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-card__stars">
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <p class="testimonial-card__text">"{{ section.settings.review_2_text | default: 'The steam cleaner works amazingly on kitchen grease. I use it on everything — countertops, stovetop, even the oven.' | escape }}"</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">
            <img src="{{ 'user-2.jpg' | asset_url }}" alt="James R." loading="lazy" width="40" height="40" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
          <div>
            <div class="testimonial-card__name">{{ section.settings.review_2_name | default: 'James R.' | escape }}</div>
            <div class="testimonial-card__meta">{{ section.settings.review_2_meta | default: 'Verified Buyer • Ontario' | escape }}</div>
          </div>
        </div>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-card__stars">
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <p class="testimonial-card__text">"{{ section.settings.review_3_text | default: 'Love the under-sink organizer and foldable storage boxes. My kitchen is finally organized. Will buy more!' | escape }}"</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">
            <img src="{{ 'user-3.jpg' | asset_url }}" alt="Maria L." loading="lazy" width="40" height="40" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
          <div>
            <div class="testimonial-card__name">{{ section.settings.review_3_name | default: 'Maria L.' | escape }}</div>
            <div class="testimonial-card__meta">{{ section.settings.review_3_meta | default: 'Verified Buyer • California' | escape }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================
     NEWSLETTER
     ============================ -->
<section class="newsletter reveal">
  <div class="newsletter__inner">
    <div>
      <h2 class="newsletter__heading">{{ section.settings.newsletter_heading | default: 'Join the Aitch Home Care family' | escape }}</h2>
      <p class="newsletter__text">{{ section.settings.newsletter_text | default: 'Subscribe for exclusive deals, new product drops, and home tips delivered to your inbox.' | escape }}</p>
    </div>
    <div>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__form">
          <input
            class="newsletter__input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' | escape }}"
            autocomplete="email"
            required
          >
          <button class="btn btn--primary" type="submit">
            {{ section.settings.newsletter_btn | default: 'Subscribe' | escape }}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

