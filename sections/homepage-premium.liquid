  </div>
</section>

<!-- ============================
     CATEGORIES GRID
     ============================ -->
<section class="section-spacing reveal reveal--stagger">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <div class="section-header__eyebrow">{{ section.settings.cats_eyebrow | default: 'Browse' | escape }}</div>
        <h2 class="section-header__title">{{ section.settings.cats_heading | default: 'Shop by Category' | escape }}</h2>
        <p class="section-header__subtitle">{{ section.settings.cats_subtitle | default: 'Find the right solution for every room in your home.' | escape }}</p>
      </div>
    </div>

    <div class="categories-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'category' %}
            {% liquid
              assign cat = block.settings.collection
              assign cat_url = block.settings.link
              if cat != blank
                assign cat_url = cat.url
              endif
              if cat_url == blank
                assign cat_url = routes.all_products_collection_url
              endif
              assign link_for_check = block.settings.link | default: ''
              if cat == blank and link_for_check contains '/collections/'
                assign lh = link_for_check | split: '/collections/' | last | split: '/' | first | split: '?' | first
                if lh != blank and collections[lh] == blank
                  if lh == 'home-convenience' and collections['home-convenience-items'] != blank
                    assign cat_url = collections['home-convenience-items'].url
                  endif
                endif
              endif
              assign cat_title = block.settings.title
              if cat_title == blank and cat != blank
                assign cat_title = cat.title
              endif
              if cat_title == blank
                assign cat_title = 'Category'
              endif
              assign cat_title_lower = cat_title | downcase
              assign cat_fallback = 'category-cleaning.jpg'
              assign force_theme_asset = false
              if cat != blank
                if cat.handle == 'kitchen-products'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-kitchen.jpg'
                elsif cat.handle == 'home-convenience' or cat.handle == 'home-convenience-items'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-home.jpg'
                elsif cat.handle == 'cleaning-tools'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-cleaning.jpg'
                endif
              endif
              if force_theme_asset == false
                if link_for_check contains 'kitchen-products'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-kitchen.jpg'
                elsif link_for_check contains 'home-convenience'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-home.jpg'
                elsif link_for_check contains 'cleaning-tools'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-cleaning.jpg'
                endif
              endif
              if force_theme_asset == false
                if cat_title_lower contains 'kitchen'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-kitchen.jpg'
                elsif cat_title_lower contains 'home'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-home.jpg'
                elsif cat_title_lower contains 'cleaning'
                  assign force_theme_asset = true
                  assign cat_fallback = 'category-cleaning.jpg'
                endif
              endif
            %}
            <a
              class="category-card"
              href="{{ cat_url }}"
              aria-label="{{ cat_title | escape }} — view products in this category"
              {{ block.shopify_attributes }}
            >
              {% if force_theme_asset %}
                <img
                  src="{{ cat_fallback | asset_url }}"
                  alt="{{ cat_title | escape }}"
                  loading="lazy"
                  width="800"
                  height="600"
                  style="object-fit: cover; width: 100%; height: 100%;"
                >
              {% elsif block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: cat_title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% elsif cat != blank and cat.featured_image != blank %}
                <img
                  src="{{ cat.featured_image | image_url: width: 800 }}"
                  alt="{{ cat.featured_image.alt | default: cat_title | escape }}"
                  loading="lazy"
                  width="{{ cat.featured_image.width }}"
                  height="{{ cat.featured_image.height }}"
                >
              {% else %}
                <img
                  src="{{ cat_fallback | asset_url }}"
                  alt="{{ cat_title | escape }}"
                  loading="lazy"
                  width="800"
                  height="600"
                  style="object-fit: cover; width: 100%; height: 100%;"
                >
              {% endif %}
              <div class="category-card__overlay"></div>
              <div class="category-card__content">
                <h3 class="category-card__title">{{ cat_title | escape }}</h3>
                <div class="category-card__meta">
                  {%- if cat != blank and cat.products_count > 0 -%}
                    <span class="category-card__badge">{{ cat.products_count }} {{ cat.products_count | pluralize: 'product', 'products' }}</span>
                    <span class="category-card__sep" aria-hidden="true">·</span>
                  {%- endif -%}
                  <span class="category-card__cta">{{ block.settings.subtitle | default: 'Shop collection' | escape }}</span>
                </div>
              </div>
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================
     TESTIMONIALS
     ============================ -->
<section class="testimonials section-spacing reveal reveal--stagger">
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        <div class="section-header__eyebrow">{{ section.settings.reviews_eyebrow | default: 'Reviews' | escape }}</div>
        <h2 class="section-header__title">{{ section.settings.reviews_heading | default: 'What Our Customers Say' | escape }}</h2>
        <p class="section-header__subtitle">{{ section.settings.reviews_subtitle | default: 'Real feedback from real home problem-solvers.' | escape }}</p>
      </div>
    </div>

    <div class="testimonials-grid">
      {% assign star_svg = '<svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' %}
      <div class="testimonial-card">
        <div class="testimonial-card__header">
          <div class="testimonial-card__stars">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</div>
          <span class="testimonial-card__verified">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Verified
          </span>
        </div>
        <p class="testimonial-card__text">"{{ section.settings.review_1_text | default: 'The Electric Spin Brush is a game changer! My bathroom has never been this clean. Saves so much time and effort.' | escape }}"</p>
        <div class="testimonial-card__author">
          <div class="testimonial-card__avatar">
            <img src="{{ 'user-1.jpg' | asset_url }}" alt="Sarah M." loading="lazy" width="44" height="44" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
          </div>
          <div>
            <div class="testimonial-card__name">{{ section.settings.review_1_name | default: 'Sarah M.' | escape }}</div>
            <div class="testimonial-card__meta">{{ section.settings.review_1_meta | default: 'Verified Buyer • Texas' | escape }}</div>
          </div>
        </div>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-card__header">
