{% liquid
  assign hero_slides = section.blocks | where: 'type', 'hero_slide'
%}

<!-- ============================
     HERO SECTION — Full-width slider
     ============================ -->
<section
  class="hero hero--slider"
  data-hero-slider
  data-autoplay="{% if section.settings.hero_autoplay %}true{% else %}false{% endif %}"
  data-interval="{{ section.settings.hero_autoplay_seconds | default: 4 | times: 1000 }}"
>
  <div
    class="hero-slider"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.hero_slider_a11y_label | default: 'Featured' | escape }}"
  >
    <div class="hero-slider__viewport">
      <div id="hero-track-{{ section.id }}" class="hero-slider__track" data-hero-track>
        {% if hero_slides.size > 0 %}
          {% for block in hero_slides %}
            {% liquid
              assign slide_img = block.settings.image
              assign align_class = 'hero-slider__inner--left'
              if block.settings.content_alignment == 'center'
                assign align_class = 'hero-slider__inner--center'
              endif
              assign promo_class = ''
              if block.settings.badge != blank
                assign promo_class = ' hero-slider__slide--promo'
              endif
            %}
            <article
              class="hero-slider__slide{{ promo_class }}{% if forloop.first %} is-active{% endif %}"
              data-hero-slide
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="hero-slider__media">
                {% if slide_img != blank %}
                  <img
                    srcset="
                      {{ slide_img | image_url: width: 800 }} 800w,
                      {{ slide_img | image_url: width: 1200 }} 1200w,
                      {{ slide_img | image_url: width: 1600 }} 1600w,
                      {{ slide_img | image_url: width: 2000 }} 2000w
                    "
                    sizes="100vw"
                    src="{{ slide_img | image_url: width: 1600 }}"
                    alt="{{ slide_img.alt | default: block.settings.heading | default: 'Aitch Home Care' | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="{{ slide_img.width }}"
                    height="{{ slide_img.height }}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                  >
                {% else %}
                  {% liquid
                    assign fallback_asset = 'hero.png'
                    if forloop.index == 2
                      assign fallback_asset = 'banner-cleaning.png'
                    elsif forloop.index == 3
                      assign fallback_asset = 'banner-kitchen.png'
                    endif
                  %}
                  <img
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ block.settings.heading | default: 'Aitch Home Care' | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="1600"
                    height="900"
                    {% if forloop.first %}fetchpriority="high"{% endif %}
                  >
                {% endif %}
              </div>
              <div class="hero-slider__scrim" aria-hidden="true"></div>
              <div class="hero-slider__inner container {{ align_class }}">
                <div class="hero-slider__content">
                  {% if block.settings.badge != blank %}
                    <p class="hero-slider__badge" aria-hidden="false">
                      <span class="hero-slider__badge-main">{{ block.settings.badge | escape }}</span>
                      {% if block.settings.badge_subtext != blank %}
                        <span class="hero-slider__badge-sub">{{ block.settings.badge_subtext | escape }}</span>
                      {% endif %}
                    </p>
                  {% endif %}
                  {% if block.settings.eyebrow != blank %}
                    <p class="hero-slider__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {% endif %}
                  {% if forloop.first %}
                    <h1 class="hero-slider__heading">{{ block.settings.heading | default: 'Solve everyday home problems. Effortlessly.' | escape }}</h1>
                  {% else %}
                    <h2 class="hero-slider__heading">{{ block.settings.heading | default: 'Solve everyday home problems. Effortlessly.' | escape }}</h2>
                  {% endif %}
                  {% if block.settings.subheading != blank %}
                    <p class="hero-slider__description">{{ block.settings.subheading | escape }}</p>
                  {% endif %}
                  <div class="hero-slider__actions">
                    {% if block.settings.primary_label != blank and block.settings.primary_link != blank %}
                      <a class="btn btn--primary btn--icon-right" href="{{ block.settings.primary_link }}">
                        <span>{{ block.settings.primary_label | escape }}</span>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                      </a>
                    {% endif %}
                    {% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}
                      <a class="btn btn--secondary" href="{{ block.settings.secondary_link }}">
                        <span>{{ block.settings.secondary_label | escape }}</span>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% comment %} Legacy: no slide blocks — use section hero settings {% endcomment %}
          <article class="hero-slider__slide is-active" data-hero-slide aria-hidden="false">
            <div class="hero-slider__media">
              {% if section.settings.hero_image != blank %}
                {% assign hero_image = section.settings.hero_image %}
                <img
                  srcset="
                    {{ hero_image | image_url: width: 800 }} 800w,
                    {{ hero_image | image_url: width: 1200 }} 1200w,
                    {{ hero_image | image_url: width: 1600 }} 1600w
                  "
                  sizes="100vw"
                  src="{{ hero_image | image_url: width: 1600 }}"
                  alt="{{ hero_image.alt | default: 'Aitch Home Care — Home Solutions' | escape }}"
                  loading="eager"
                  width="{{ hero_image.width }}"
                  height="{{ hero_image.height }}"
                  fetchpriority="high"
                >
              {% else %}
                <img
                  src="{{ 'hero.png' | asset_url }}"
                  alt="Aitch Home Care — Premium Home Solutions"
                  loading="eager"
                  width="1200"
                  height="auto"
                  fetchpriority="high"
                >
              {% endif %}
            </div>
            <div class="hero-slider__scrim" aria-hidden="true"></div>
            <div class="hero-slider__inner container hero-slider__inner--left">
              <div class="hero-slider__content">
                <h1 class="hero-slider__heading">{{ section.settings.heading | default: 'Solve everyday home problems. Effortlessly.' | escape }}</h1>
                <p class="hero-slider__description">{{ section.settings.subheading | default: 'Premium cleaning tools, kitchen essentials, and home convenience products — curated for everyday wins.' | escape }}</p>
                <div class="hero-slider__actions">
                  {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
                    <a class="btn btn--primary btn--icon-right" href="{{ section.settings.primary_link }}">
                      <span>{{ section.settings.primary_label | escape }}</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                    </a>
                  {% endif %}
                  {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
                    <a class="btn btn--secondary" href="{{ section.settings.secondary_link }}">
                      <span>{{ section.settings.secondary_label | escape }}</span>
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </article>
        {% endif %}
      </div>
    </div>

    {% if hero_slides.size > 1 %}
      <div class="hero-slider__controls">
        <button
          type="button"
          class="hero-slider__btn hero-slider__btn--prev"
          data-hero-prev
          aria-controls="hero-track-{{ section.id }}"
          aria-label="Previous slide"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button
          type="button"
          class="hero-slider__btn hero-slider__btn--next"
          data-hero-next
          aria-controls="hero-track-{{ section.id }}"
          aria-label="Next slide"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <div class="hero-slider__dots-wrap">
        <div class="hero-slider__dots" data-hero-dots role="tablist" aria-label="{{ section.settings.hero_slider_a11y_label | default: 'Slides' | escape }}"></div>
      </div>
      <div class="hero-slider__progress" data-hero-progress aria-hidden="true">
        <span class="hero-slider__progress-bar" data-hero-progress-bar></span>
      </div>
    {% endif %}
  </div>

  <!-- Stats Bar -->
  <div class="hero__stats">
    <div class="hero__stat">
      <div class="hero__stat-value hero-count" data-raw="{{ section.settings.stat_1_value | default: '20+' | escape }}">{{ section.settings.stat_1_value | default: '20+' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_1_label | default: 'Curated Products' | escape }}</div>
    </div>
    <div class="hero__stat">
      <div class="hero__stat-value hero-count" data-raw="{{ section.settings.stat_2_value | default: '2-5 Day' | escape }}">{{ section.settings.stat_2_value | default: '2-5 Day' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_2_label | default: 'Fast Shipping' | escape }}</div>
    </div>
    <div class="hero__stat">
      <div class="hero__stat-value hero-count" data-raw="{{ section.settings.stat_3_value | default: '30 Day' | escape }}">{{ section.settings.stat_3_value | default: '30 Day' | escape }}</div>
      <div class="hero__stat-label">{{ section.settings.stat_3_label | default: 'Easy Returns' | escape }}</div>
    </div>
  </div>
</section>

{% liquid
  assign t_limit = section.settings.trending_product_limit | default: 4
  assign a_limit = section.settings.all_product_limit | default: 8
  
  assign c_all = section.settings.all_collection
  if c_all == blank
    assign c_all = collections.all
  endif

  # Trending resolution
  assign c_trending = section.settings.trending_collection
  if c_trending != blank and c_trending.handle == blank
    assign c_trending = collections[c_trending]
  endif
  if c_trending == blank
    assign c_trending = section.settings.collection
    if c_trending != blank and c_trending.handle == blank
      assign c_trending = collections[c_trending]
    endif
  endif
  if c_trending == blank
    assign c_trending = collections['trending-now']
  endif
  if c_trending == blank
    assign c_trending = collections['best-sales']
  endif
%}

{% render 'homepage-product-row',
  collection: c_trending,
  row_variant: 'trending',
  eyebrow: section.settings.trending_eyebrow,
  heading: section.settings.trending_heading,
  subheading: section.settings.trending_subheading,
  product_limit: t_limit,
  cta_label: section.settings.trending_cta_label,
  cta_link: section.settings.trending_cta_link
%}

{% render 'homepage-product-row',
  collection: c_all,
  eyebrow: section.settings.all_eyebrow,
  heading: section.settings.all_heading,
  subheading: section.settings.all_subheading,
  product_limit: a_limit,
  cta_label: section.settings.all_cta_label,
  cta_link: section.settings.all_cta_link
%}

