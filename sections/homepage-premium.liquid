<section class="newsletter reveal reveal--stagger">
  <div class="newsletter__inner">
    <div>
      <div class="newsletter__badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Newsletter
      </div>
      <h2 class="newsletter__heading">{{ section.settings.newsletter_heading | default: 'Join the Aitch Home Care family' | escape }}</h2>
      <p class="newsletter__text">{{ section.settings.newsletter_text | default: 'Subscribe for exclusive deals, new product drops, and home tips delivered to your inbox.' | escape }}</p>
    </div>
    <div>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}
          <div class="newsletter__success">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <p>Thanks for subscribing! Check your inbox.</p>
          </div>
        {% else %}
          <div class="newsletter__form">
            <input
              class="newsletter__input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' | escape }}"
              autocomplete="email"
              required
            >
            <button class="btn btn--primary newsletter__btn" type="submit">
              {{ section.settings.newsletter_btn | default: 'Subscribe' | escape }}
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        {% endif %}
      {% endform %}
      <p class="newsletter__privacy">No spam, ever. Unsubscribe anytime.</p>
    </div>
  </div>
</section>

{% if hero_slides.size > 1 %}
  <script>
    (function () {
      var root = document.querySelector('[data-hero-slider]');
      if (!root) return;
      var track = root.querySelector('[data-hero-track]');
      var slides = root.querySelectorAll('[data-hero-slide]');
      var dotsWrap = root.querySelector('[data-hero-dots]');
      var prev = root.querySelector('[data-hero-prev]');
      var next = root.querySelector('[data-hero-next]');
      var progressBar = root.querySelector('[data-hero-progress-bar]');
      if (!track || slides.length < 2) return;

      var autoplay = root.getAttribute('data-autoplay') === 'true';
      var interval = parseInt(root.getAttribute('data-interval'), 10) || 4000;
      var i = 0;
      var timer;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function restartProgress() {
        if (!progressBar || !autoplay || reduceMotion) return;
        progressBar.classList.remove('hero-slider__progress-bar--run');
        progressBar.style.animationDuration = interval / 1000 + 's';
        void progressBar.offsetWidth;
        progressBar.classList.add('hero-slider__progress-bar--run');
      }

      function go(n) {
        i = (n + slides.length) % slides.length;
        track.style.transform = 'translateX(-' + i * 100 + '%)';
        slides.forEach(function (s, j) {
          s.classList.toggle('is-active', j === i);
          s.setAttribute('aria-hidden', j === i ? 'false' : 'true');
        });
        if (dotsWrap) {
          var btns = dotsWrap.querySelectorAll('button');
          btns.forEach(function (b, j) {
            b.setAttribute('aria-selected', j === i ? 'true' : 'false');
            b.tabIndex = j === i ? 0 : -1;
          });
        }
      }

      function startAutoplay() {
        if (timer) clearInterval(timer);
        timer = null;
        if (!autoplay || reduceMotion || slides.length < 2) {
          if (progressBar) progressBar.classList.remove('hero-slider__progress-bar--run');
          return;
        }
        restartProgress();
        timer = setInterval(function () {
          go(i + 1);
          restartProgress();
        }, interval);
      }

      function dotButtons() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        slides.forEach(function (_, j) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'hero-slider__dot';
          b.setAttribute('role', 'tab');
          b.setAttribute('aria-label', 'Go to slide ' + (j + 1));
          b.addEventListener('click', function () {
            go(j);
            startAutoplay();
          });
          dotsWrap.appendChild(b);
        });
      }

      dotButtons();
      go(0);

      if (prev)
        prev.addEventListener('click', function () {
          go(i - 1);
          startAutoplay();
        });
      if (next)
        next.addEventListener('click', function () {
          go(i + 1);
          startAutoplay();
        });

      root.addEventListener('mouseenter', function () {
        if (timer) clearInterval(timer);
        timer = null;
        root.classList.add('hero-slider--paused');
      });
      root.addEventListener('mouseleave', function () {
        root.classList.remove('hero-slider--paused');
        startAutoplay();
      });

      startAutoplay();
    })();
  </script>
{% endif %}

