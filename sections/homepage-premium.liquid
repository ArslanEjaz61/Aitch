      </div>
      <div class="trust-bar__text">
        <strong>{{ section.settings.trust_1_title | default: 'Problem-Solving Tools' | escape }}</strong>
        <span>{{ section.settings.trust_1_text | default: 'Every product solves a real home problem' | escape }}</span>
      </div>
    </div>
    <div class="trust-bar__item">
      <div class="trust-bar__icon">
