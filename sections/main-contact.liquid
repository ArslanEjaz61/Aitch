<!-- Contact Hero -->
<div class="contact-hero">
  <div class="container">
    <div class="contact-hero__inner">
      <div class="section-header__eyebrow">Get in Touch</div>
      <h1 class="contact-hero__title">{{ section.settings.heading | default: "We're Here to Help" | escape }}</h1>
      <p class="contact-hero__desc">{{ section.settings.subheading | default: "Have a question about a product, your order, or anything else? We'd love to hear from you. Our team typically responds within 24 hours." | escape }}</p>
    </div>
  </div>
</div>

<div class="contact-page">
  <div class="container">
    <div class="contact-page__grid">

      <!-- Contact Form -->
      <div class="contact-page__form-col">
        <div class="contact-page__card">
          <h2 class="contact-page__card-title">Send Us a Message</h2>
          <p class="contact-page__card-desc">Fill out the form below and we'll get back to you as soon as possible.</p>

          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div class="contact-page__success">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div>
                  <strong>Message sent!</strong>
                  <p>Thank you for reaching out. We'll get back to you within 24 hours.</p>
                </div>
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="contact-page__error">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {% endif %}

            <div class="contact-form__row">
              <div class="contact-form__field">
                <label for="contact-name" class="contact-form__label">Full Name</label>
                <input type="text" id="contact-name" name="contact[name]" placeholder="John Doe" required class="contact-form__input">
              </div>
              <div class="contact-form__field">
                <label for="contact-email" class="contact-form__label">Email Address</label>
                <input type="email" id="contact-email" name="contact[email]" placeholder="john@example.com" required class="contact-form__input">
              </div>
            </div>

            <div class="contact-form__field">
              <label for="contact-phone" class="contact-form__label">Phone Number <span class="contact-form__optional">(Optional)</span></label>
              <input type="tel" id="contact-phone" name="contact[phone]" placeholder="+1 (555) 000-0000" class="contact-form__input">
            </div>

            <div class="contact-form__field">
              <label for="contact-subject" class="contact-form__label">Subject</label>
              <select id="contact-subject" name="contact[subject]" class="contact-form__input contact-form__select">
                <option value="" disabled selected>Select a topic</option>
                <option value="Order Inquiry">Order Inquiry</option>
                <option value="Product Question">Product Question</option>
                <option value="Shipping & Delivery">Shipping & Delivery</option>
                <option value="Returns & Refunds">Returns & Refunds</option>
                <option value="Wholesale Inquiry">Wholesale Inquiry</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="contact-form__field">
              <label for="contact-message" class="contact-form__label">Message</label>
              <textarea id="contact-message" name="contact[body]" rows="5" placeholder="Tell us how we can help..." required class="contact-form__input contact-form__textarea"></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--full contact-form__submit">
              Send Message
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          {% endform %}
        </div>
      </div>

      <!-- Contact Info Sidebar -->
      <div class="contact-page__info-col">
        <div class="contact-page__info-card">
          <div class="contact-info__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 class="contact-info__title">Email Us</h3>
          <p class="contact-info__text">{{ section.settings.email | default: 'support@aitchhomecare.com' | escape }}</p>
          <p class="contact-info__note">We reply within 24 hours</p>
        </div>

        <div class="contact-page__info-card">
          <div class="contact-info__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3 class="contact-info__title">Shipping</h3>
          <p class="contact-info__text">USA & Canada</p>
          <p class="contact-info__note">2–5 day delivery on all orders</p>
        </div>

        <div class="contact-page__info-card">
          <div class="contact-info__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="contact-info__title">Business Hours</h3>
          <p class="contact-info__text">{{ section.settings.hours | default: 'Mon–Fri: 9AM – 5PM EST' | escape }}</p>
          <p class="contact-info__note">Excluding public holidays</p>
        </div>

        <div class="contact-page__info-card">
          <div class="contact-info__icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
          </div>
          <h3 class="contact-info__title">Returns</h3>
          <p class="contact-info__text">30-Day Money Back</p>
          <p class="contact-info__note">Hassle-free, no questions asked</p>
        </div>

        <!-- Quick Links -->
        <div class="contact-page__quick-links">
          <h4 class="contact-quick__title">Quick Links</h4>
          <a href="/policies/shipping-policy" class="contact-quick__link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            Shipping Policy
          </a>
          <a href="/policies/refund-policy" class="contact-quick__link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            Refund Policy
          </a>
          <a href="/policies/privacy-policy" class="contact-quick__link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            Privacy Policy
          </a>
          <a href="/collections/all" class="contact-quick__link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            Browse Products
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're Here to Help"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Have a question about a product, your order, or anything else? We'd love to hear from you. Our team typically responds within 24 hours."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "support@aitchhomecare.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Mon–Fri: 9AM – 5PM EST"
    }
  ]
}
{% endschema %}
