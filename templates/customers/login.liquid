<div class="page-content" style="max-width:480px;">
  <h1>Sign In</h1>

  {% form 'customer_login' %}
    {{ form.errors | default_errors }}

    <div style="display:flex;flex-direction:column;gap:var(--space-md);">
      <div>
        <label for="login-email" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">Email</label>
        <input id="login-email" class="newsletter__input" style="width:100%;" type="email" name="customer[email]" autocomplete="email" placeholder="your@email.com" required>
      </div>
      <div>
        <label for="login-password" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">Password</label>
        <input id="login-password" class="newsletter__input" style="width:100%;" type="password" name="customer[password]" autocomplete="current-password" placeholder="Password" required>
      </div>
      <button class="btn btn--primary btn--full" type="submit">Sign In</button>
    </div>
  {% endform %}

  <div style="display:flex;align-items:center;justify-content:center;gap:var(--space-lg);margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:1px solid var(--color-border);">
    <a class="btn btn--link" href="{{ routes.account_register_url }}">Create account</a>
    <span style="color:var(--color-text-tertiary);">•</span>
    <a class="btn btn--link" href="#" onclick="document.getElementById('recover-form').style.display='block';this.parentNode.style.display='none';">Forgot password?</a>
  </div>

  <div id="recover-form" style="display:none;margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:1px solid var(--color-border);">
    <h2 style="font-size:var(--font-size-lg);margin-bottom:var(--space-md);">Reset Password</h2>
    {% form 'recover_customer_password' %}
      <div style="display:flex;gap:var(--space-sm);">
        <input class="newsletter__input" style="flex:1;" type="email" name="email" placeholder="your@email.com" autocomplete="email" required>
        <button class="btn btn--primary" type="submit">Reset</button>
      </div>
    {% endform %}
  </div>
</div>
