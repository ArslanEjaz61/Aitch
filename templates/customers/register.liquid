<div class="page-content" style="max-width:480px;">
  <h1>Create Account</h1>

  {% form 'create_customer' %}
    {{ form.errors | default_errors }}

    <div style="display:flex;flex-direction:column;gap:var(--space-md);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-md);">
        <div>
          <label for="reg-fname" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">First name</label>
          <input id="reg-fname" class="newsletter__input" style="width:100%;" type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name">
        </div>
        <div>
          <label for="reg-lname" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">Last name</label>
          <input id="reg-lname" class="newsletter__input" style="width:100%;" type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name">
        </div>
      </div>
      <div>
        <label for="reg-email" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">Email</label>
        <input id="reg-email" class="newsletter__input" style="width:100%;" type="email" name="customer[email]" autocomplete="email" placeholder="your@email.com" required>
      </div>
      <div>
        <label for="reg-password" style="display:block;font-size:var(--font-size-sm);font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--color-text-secondary);margin-bottom:var(--space-xs);">Password</label>
        <input id="reg-password" class="newsletter__input" style="width:100%;" type="password" name="customer[password]" autocomplete="new-password" placeholder="Minimum 8 characters" required>
      </div>
      <button class="btn btn--primary btn--full" type="submit">Create Account</button>
    </div>
  {% endform %}

  <div style="text-align:center;margin-top:var(--space-xl);padding-top:var(--space-lg);border-top:1px solid var(--color-border);">
    <span style="color:var(--color-text-secondary);">Already have an account?</span>
    <a class="btn btn--link" href="{{ routes.account_login_url }}" style="margin-left:var(--space-sm);">Sign in</a>
  </div>
</div>
