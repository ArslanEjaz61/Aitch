<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-animations="{% if settings.animations_reveal %}on{% else %}off{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {% endif %}

    <title>
      {{ page_title }}
      {% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta name="theme-color" content="{{ settings.colors_accent | default: settings.brand_color | default: '#1a1a1a' }}">

    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'theme-css-variables' %}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="sr-only focusable" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.animations_reveal %}
      <script src="{{ 'theme-animations.js' | asset_url }}" defer></script>
    {% else %}
      <script>
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('visible'); });
      </script>
    {% endif %}

    <script>
      (function() {
        /* ============================
           HEADER SCROLL EFFECT
           ============================ */
        var header = document.querySelector('.header');
        if (header) {
          window.addEventListener('scroll', function() {
            if (window.pageYOffset > 50) header.classList.add('scrolled');
            else header.classList.remove('scrolled');
          }, { passive: true });
        }

        /* ============================
           MOBILE MENU
           ============================ */
        var toggle = document.querySelector('.header__menu-toggle');
        var menu = document.querySelector('.mobile-menu');
        var close = document.querySelector('.mobile-menu__close');
        if (toggle && menu) {
          toggle.addEventListener('click', function() { menu.classList.add('active'); document.body.style.overflow = 'hidden'; });
          if (close) close.addEventListener('click', function() { menu.classList.remove('active'); document.body.style.overflow = ''; });
        }

        /* ============================
           PAGE LOAD FADE-IN
           ============================ */
        var main = document.getElementById('MainContent');
        if (main) main.classList.add('page-transition-in');

        /* ============================
           SCROLL REVEAL — IntersectionObserver
           ============================ */
        function initScrollReveal() {
          var elements = document.querySelectorAll('.reveal-on-scroll, .reveal-left, .reveal-right, .reveal-scale');
          if (!elements.length) return;

          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

            elements.forEach(function(el) { observer.observe(el); });
          } else {
            // Fallback: show all
            elements.forEach(function(el) { el.classList.add('is-visible'); });
          }
        }

        /* Auto-apply reveal classes to sections & grid items */
        function autoApplyRevealClasses() {
          var isProduct = document.body.classList.contains('template-product');
          // Sections get reveal-on-scroll (product description tabs excluded — must show immediately, not after scroll)
          var sectionSelector = '.section-spacing, .hero, .newsletter, .related-products, .section-header';
          if (!isProduct) sectionSelector += ', .product-tabs';
          document.querySelectorAll(sectionSelector).forEach(function(s) {
            if (!s.classList.contains('reveal-on-scroll')) s.classList.add('reveal-on-scroll');
          });

          // Product cards get staggered reveals
          var grids = document.querySelectorAll('.product-grid');
          grids.forEach(function(grid) {
            var cards = grid.querySelectorAll('.product-card');
            cards.forEach(function(card, i) {
              card.classList.add('reveal-on-scroll');
              card.classList.add('stagger-' + Math.min(i + 1, 8));
            });
          });

          // Category cards
          var catCards = document.querySelectorAll('.category-card');
          catCards.forEach(function(card, i) {
            card.classList.add('reveal-on-scroll');
            card.classList.add('stagger-' + Math.min(i + 1, 8));
          });

          // Trust badges (skip on PDP — keep buy box visible immediately)
          if (!isProduct) {
            document.querySelectorAll('.product-page__trust-item').forEach(function(item, i) {
              item.classList.add('reveal-on-scroll');
              item.classList.add('stagger-' + (i + 1));
            });
          }

          // Testimonial cards
          var testimonials = document.querySelectorAll('.testimonial-card');
          testimonials.forEach(function(card, i) {
            card.classList.add('reveal-on-scroll');
            card.classList.add('stagger-' + Math.min(i + 1, 8));
          });
        }

        /* ============================
           HERO PARALLAX
           ============================ */
        function initParallax() {
          window.addEventListener('scroll', function() {
            var activeSlide = document.querySelector('[data-hero-slide][aria-hidden="false"]');
            var heroMedia = activeSlide
              ? activeSlide.querySelector('.hero-slider__media')
              : document.querySelector('.hero-slider__media');
            if (!heroMedia) return;
            var scrolled = window.pageYOffset;
            if (scrolled < window.innerHeight) {
              heroMedia.style.transform = 'translateY(' + (scrolled * 0.15) + 'px)';
            }
          }, { passive: true });
        }

        /* ============================
           NUMBER COUNTER ANIMATION
           ============================ */
        function initCounters() {
          var counters = document.querySelectorAll('[data-count]');
          if (!counters.length) return;

          var counterObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                var el = entry.target;
                var target = parseInt(el.getAttribute('data-count'), 10);
                var duration = 1500;
                var start = 0;
                var startTime = null;

                function animate(timestamp) {
                  if (!startTime) startTime = timestamp;
                  var progress = Math.min((timestamp - startTime) / duration, 1);
                  var eased = 1 - Math.pow(1 - progress, 3);
                  el.textContent = Math.floor(eased * target).toLocaleString();
                  if (progress < 1) requestAnimationFrame(animate);
                  else el.textContent = target.toLocaleString();
                }
                requestAnimationFrame(animate);
                counterObserver.unobserve(el);
              }
            });
          }, { threshold: 0.5 });

          counters.forEach(function(c) { counterObserver.observe(c); });
        }

        /* ============================
           CART WIGGLE — Add to cart feedback
           ============================ */
        document.addEventListener('submit', function(e) {
          var form = e.target;
          if (form.action && form.action.indexOf('/cart/add') > -1) {
            var cartBtn = document.querySelector('.header__action-btn[aria-label="Cart"]');
            if (cartBtn) {
              cartBtn.classList.add('cart-wiggle');
              setTimeout(function() { cartBtn.classList.remove('cart-wiggle'); }, 700);
            }
          }
        });

        /* ============================
           INIT ALL
           ============================ */
        document.addEventListener('DOMContentLoaded', function() {
          autoApplyRevealClasses();
          initScrollReveal();
          initParallax();
          initCounters();
        });

        // Fallback if DOMContentLoaded already fired
        if (document.readyState !== 'loading') {
          autoApplyRevealClasses();
          initScrollReveal();
          initParallax();
          initCounters();
        }
      })();
    </script>

    <!-- Search Modal Drawer Overlay -->
    <div id="search-modal" class="search-modal" aria-hidden="true" role="dialog">
      <div class="search-modal__overlay" onclick="closeSearchModal()"></div>
      <div class="search-modal__content">
        <div class="search-modal__header">
          <h2 class="search-modal__title">Search our store</h2>
          <button type="button" class="search-modal__close" onclick="closeSearchModal()" aria-label="Close search">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        
        <form action="/search" method="get" class="search-modal__form">
          <input 
            type="text" 
            name="q" 
            id="search-modal-input" 
            placeholder="What are you looking for?" 
            autocomplete="off"
            class="search-modal__input"
          >
          <button type="submit" class="search-modal__submit" aria-label="Submit search">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
        </form>

        <div class="search-modal__results" id="search-modal-results">
          <!-- Default suggestions when input is empty -->
          <div class="search-modal__suggestions">
            <h3 class="search-modal__subtitle">Popular Suggestions</h3>
            <div class="search-modal__suggested-links">
              <a href="/collections/cleaning">Cleaning Tools</a>
              <a href="/collections/kitchen-tools">Kitchen Problem Solvers</a>
              <a href="/collections/home-convenience">Home Convenience</a>
              <a href="/pages/best-sellers">Best Sellers</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Search Modal Logic Script -->
    <script>
      function openSearchModal(e) {
        if (e) e.preventDefault();
        var modal = document.getElementById('search-modal');
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
          setTimeout(function() {
            var input = document.getElementById('search-modal-input');
            if (input) input.focus();
          }, 100);
        }
      }

      function closeSearchModal() {
        var modal = document.getElementById('search-modal');
        if (modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
        }
      }

      // Bind all search trigger buttons
      document.addEventListener('DOMContentLoaded', function() {
        var searchBtns = document.querySelectorAll('a[href*="/search"], button[aria-label="Search"]');
        searchBtns.forEach(function(btn) {
          btn.addEventListener('click', openSearchModal);
        });

        // Predictive live suggestions
        var searchInput = document.getElementById('search-modal-input');
        var searchResults = document.getElementById('search-modal-results');
        
        if (searchInput && searchResults) {
          var debounceTimer;
          searchInput.addEventListener('input', function() {
            var query = searchInput.value.trim();
            clearTimeout(debounceTimer);
            
            if (query.length < 2) {
              searchResults.innerHTML = `
                <div class="search-modal__suggestions">
                  <h3 class="search-modal__subtitle">Popular Suggestions</h3>
                  <div class="search-modal__suggested-links">
                    <a href="/collections/cleaning">Cleaning Tools</a>
                    <a href="/collections/kitchen-tools">Kitchen Problem Solvers</a>
                    <a href="/collections/home-convenience">Home Convenience</a>
                    <a href="/pages/best-sellers">Best Sellers</a>
                  </div>
                </div>
              `;
              return;
            }

            debounceTimer = setTimeout(function() {
              searchResults.innerHTML = '<div style="text-align:center;padding:var(--space-md);color:var(--color-text-secondary);font-size:var(--font-size-sm);">Searching suggestions...</div>';
              
              fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=5')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                  var products = data.resources.results.products;
                  if (products && products.length > 0) {
                    var html = '<h3 class="search-modal__subtitle">Suggested Products</h3>';
                    products.forEach(function(p) {
                      html += `
                        <a href="${p.url}" class="search-modal__item">
                          <img src="${p.image || 'https://cdn.shopify.com/s/images/admin/no-image-large.gif'}" class="search-modal__item-img" alt="${p.title}">
                          <div class="search-modal__item-info">
                            <span class="search-modal__item-title">${p.title}</span>
                            <span class="search-modal__item-price">${p.price}</span>
                          </div>
                        </a>
                      `;
                    });
                    searchResults.innerHTML = html;
                  } else {
                    searchResults.innerHTML = `
                      <div class="search-modal__suggestions">
                        <h3 class="search-modal__subtitle">No results found</h3>
                        <p style="font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-top: 4px;">Try searching for something else, like "scrubber" or "organizer".</p>
                      </div>
                    `;
                  }
                })
                .catch(function(err) {
                  console.error('Predictive search suggestions error:', err);
                });
            }, 250);
          });
        }
      });
    </script>
  </body>
</html>
