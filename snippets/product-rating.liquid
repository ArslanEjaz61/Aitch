{% comment %}
  Shopify standard product rating metafields (reviews.rating + reviews.rating_count).
  Pass compact: true on product cards. Renders nothing when disabled or no data.
{% endcomment %}
{% if settings.show_product_rating == false %}
{% elsif product.metafields.reviews.rating.value == blank %}
{% else %}
  {% liquid
    assign r = product.metafields.reviews.rating.value
    assign scale = r.scale_max | default: 5
    assign score = r.rating
    assign count_raw = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0
    assign count = count_raw | plus: 0
    assign pct = score | times: 100 | divided_by: scale
    if pct > 100
      assign pct = 100
    endif
    assign rating_class = 'product-rating'
    if compact
      assign rating_class = 'product-rating product-rating--compact'
    endif
  %}
  <div
    class="{{ rating_class }}"
    role="img"
    aria-label="{{ score }} out of {{ scale }} stars{% if count > 0 %} from {{ count }} reviews{% endif %}"
  >
    <span class="product-rating__stars" aria-hidden="true">
      <span class="product-rating__stars-bg">★★★★★</span>
      <span class="product-rating__stars-fill" style="width: {{ pct }}%;">★★★★★</span>
    </span>
    <span class="product-rating__value">{{ score | round: 1 }}</span>
    {% if count > 0 and compact != true %}
      <span class="product-rating__count">({{ count }} {{ count | pluralize: 'review', 'reviews' }})</span>
    {% endif %}
  </div>
{% endif %}
