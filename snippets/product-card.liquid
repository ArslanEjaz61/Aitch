{% comment %}
  Renders a product card in Atlas style.

  Usage:
    {% render 'product-card', product: product %}

  Parameters:
    product     - Shopify product object
    show_vendor - Boolean to show/hide vendor name (default: true)
{% endcomment %}

<article class="product-card product-card--ratio-{{ settings.product_card_ratio | default: 'square' }}">
  <div class="product-card__badges">
    {% if product.tags contains 'best-seller' or product.tags contains 'Best Seller' %}
      <span class="product-card__badge product-card__badge--best">Best Seller</span>
    {% endif %}
    {% if product.compare_at_price_max > product.price %}
      {% assign card_savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}
      <span class="product-card__badge product-card__badge--sale">{{ card_savings }}% Off</span>
    {% endif %}
    {% if product.tags contains 'new' or product.tags contains 'New' %}
      <span class="product-card__badge product-card__badge--new">New</span>
    {% endif %}
  </div>

  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_image %}
      <img
        srcset="
          {{ product.featured_image | image_url: width: 400 }} 400w,
          {{ product.featured_image | image_url: width: 600 }} 600w,
          {{ product.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | escape }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}

    {% if product.images.size > 1 %}
      <div class="product-card__media-hover">
        <img
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | escape }}"
          loading="lazy"
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
        >
      </div>
    {% endif %}

    {% if settings.show_quick_view != false %}
      <div class="product-card__overlay-btn">
        <span>
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          Quick View
        </span>
      </div>
    {% endif %}
  </a>

  <div class="product-card__info">
    {% unless show_vendor == false or settings.show_product_vendor == false %}
      {% if product.vendor != blank %}
        <div class="product-card__vendor">{{ product.vendor | escape }}</div>
      {% endif %}
    {% endunless %}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="product-card__price">
      {% if product.compare_at_price_max > product.price %}
        <span class="product-card__price-sale">{{ product.price | money }}</span>
        <span class="product-card__price-compare">{{ product.compare_at_price_max | money }}</span>
      {% else %}
        <span class="product-card__price-current">{{ product.price | money }}</span>
      {% endif %}
    </div>

    {% if product.available %}
      <form action="{{ routes.cart_add_url }}" method="post" class="product-card__atc-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="return_to" value="/cart">
        <button type="submit" class="product-card__atc-btn">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/></svg>
          Add to Cart
        </button>
      </form>
    {% else %}
      <div class="product-card__atc-form">
        <button type="button" class="product-card__atc-btn product-card__atc-btn--soldout" disabled>
          Sold Out
        </button>
      </div>
    {% endif %}
  </div>
</article>
